{
  "name": "midi-community",
  "version": "0.1.0",
  "private": true,
  "description": "The field guide to MIDI: protocol docs, interactive tools, and a curated catalog of open-source MIDI libraries.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-data.mjs && node scripts/generate-readme.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "test": "node --test tests/",
    "verify": "node scripts/verify-links.mjs",
    "readme": "node scripts/generate-readme.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "verify:samples": "node scripts/verify-samples.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "astro": "^7.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
