{
  "name": "midi-community",
  "version": "0.1.0",
  "private": true,
  "description": "How MIDI works, down to the byte. Browser tools for MIDI files and gear, and a catalog of open-source MIDI libraries checked against their repositories.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://midi.community",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wustep/midi.git"
  },
  "bugs": {
    "url": "https://github.com/wustep/midi/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate-data.mjs && node scripts/generate-readme.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "test": "node --test tests/",
    "verify": "node scripts/verify-links.mjs",
    "readme": "node scripts/generate-readme.mjs",
    "check:data": "node scripts/validate-data.mjs",
    "verify:resources": "node scripts/verify-resources.mjs",
    "verify:samples": "node scripts/verify-samples.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/sofia-sans": "^5.3.0",
    "@fontsource-variable/sofia-sans-condensed": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "satori": "^0.63.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "fflate": "^0.7.5"
  }
}
