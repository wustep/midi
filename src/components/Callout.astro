---
interface Props {
  type?: 'info' | 'warn' | 'note';
  title?: string;
}
const { type = 'info', title } = Astro.props;
const defaults = { info: 'Good to know', warn: 'Watch out', note: 'Note' };
---

<div role="note" class:list={['callout', type !== 'info' && type]}>
  <p class="callout-title">{title ?? defaults[type]}</p>
  <slot />
</div>
