---
import { SCALES, CHORDS } from '../lib/theory';
import instruments from '../../data/samples.json';

const roots = ['C', 'C♯', 'D♭', 'D', 'D♯', 'E♭', 'E', 'F', 'F♯', 'G♭', 'G', 'G♯', 'A♭', 'A', 'A♯', 'B♭', 'B'];
const pitched = instruments.filter((i) => !i.drumMap);
---

<section class="widget cs" data-cs aria-labelledby="cs-title">
  <div class="widget-head">
    <h2 class="widget-title" id="cs-title">Chords &amp; scales</h2>
    <span class="widget-tag">spelled · numbered · playable</span>
  </div>

  <div class="seg cs-mode" role="group" aria-label="Show">
    <button type="button" class="chip" data-mode="chord" aria-pressed="true">Chord</button>
    <button type="button" class="chip" data-mode="scale" aria-pressed="false">Scale</button>
  </div>

  <div class="cs-controls">
    <label><span class="field-label">Root</span>
      <select data-root>{roots.map((r) => <option value={r} selected={r === 'C'}>{r}</option>)}</select>
    </label>
    <label><span class="field-label">Octave</span>
      <select data-oct>{[1, 2, 3, 4, 5, 6].map((o) => <option selected={o === 4}>{o}</option>)}</select>
    </label>
    <label class="cs-type" data-chord-ctl><span class="field-label">Chord</span>
      <select data-chord>{CHORDS.map((c) => <option value={c.id}>{c.symbol || 'maj'} · {c.name}</option>)}</select>
    </label>
    <label data-chord-ctl><span class="field-label">Inversion</span>
      <select data-inv><option value="0">Root position</option><option value="1">1st</option><option value="2">2nd</option><option value="3">3rd</option></select>
    </label>
    <label class="cs-type" data-scale-ctl hidden><span class="field-label">Scale</span>
      <select data-scale>{SCALES.map((s) => <option value={s.id}>{s.name}</option>)}</select>
    </label>
  </div>

  <div class="cs-out">
    <p class="cs-symbol" data-symbol aria-live="polite"></p>
    <div class="table-wrap cs-notes-wrap"><table class="cs-notes" data-notes></table></div>
    <div class="cs-keys" data-keys aria-hidden="true"></div>
    <p class="cs-bytes" data-bytes></p>
  </div>

  <div class="cs-play">
    <button type="button" class="btn btn-primary" data-play="block">Play together</button>
    <button type="button" class="btn" data-play="arp">Play one by one</button>
    <label class="cs-inline"><span>Sound</span>
      <select data-sound>
        {pitched.map((i) => <option value={i.id}>{i.name}</option>)}
        <option value="midi">Web MIDI output…</option>
      </select>
    </label>
    <label class="cs-inline" data-out-wrap hidden><span>Output</span><select data-out></select></label>
    <label class="cs-inline" data-ch-wrap hidden><span>Channel</span><select data-ch>{Array.from({ length: 16 }, (_, i) => <option>{i + 1}</option>)}</select></label>
    <span class="cs-status" data-status role="status"></span>
  </div>

  <div class="cs-diatonic" data-diatonic-wrap hidden>
    <h3 class="cs-h">Chords in this key</h3>
    <div class="seg" role="group" aria-label="Chord size">
      <button type="button" class="chip" data-sev="0" aria-pressed="true">Triads</button>
      <button type="button" class="chip" data-sev="1" aria-pressed="false">Sevenths</button>
    </div>
    <ul class="cs-dia" data-diatonic></ul>
  </div>

  <div class="cs-detect">
    <h3 class="cs-h">What am I playing?</h3>
    <p class="cs-hint">Play notes on a MIDI keyboard and the chord is named live. Hold the notes; release to clear.</p>
    <button type="button" class="btn" data-listen>Listen to a MIDI keyboard</button>
    <p class="cs-detected" data-detected aria-live="polite"></p>
  </div>
</section>

<script>
  import { SCALES, CHORDS, parsePitch, build, diatonicChords, identifyChord, chordSymbol, type SpelledNote } from '../lib/theory';
  import { Sampler, type Instrument } from '../lib/sampler';
  import { noteName, hexBytes } from '../lib/midi';
  import { midiAccess, bindPortSelect } from '../lib/webmidi';
  import data from '../../data/samples.json';

  const insts = data as Instrument[];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const isBlack = (n: number) => [1, 3, 6, 8, 10].includes(n % 12);

  for (const root of document.querySelectorAll<HTMLElement>('[data-cs]')) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const rootSel = $<HTMLSelectElement>('[data-root]');
    const octSel = $<HTMLSelectElement>('[data-oct]');
    const chordSel = $<HTMLSelectElement>('[data-chord]');
    const invSel = $<HTMLSelectElement>('[data-inv]');
    const scaleSel = $<HTMLSelectElement>('[data-scale]');
    const soundSel = $<HTMLSelectElement>('[data-sound]');
    const status = $('[data-status]');
    let mode: 'chord' | 'scale' = 'chord';
    let sevenths = false;
    let notes: SpelledNote[] = [];
    let ctx: AudioContext | undefined;
    let sampler: Sampler | undefined;
    let access: MIDIAccess | undefined;
    let getOut: (() => MIDIOutput | undefined) | undefined;
    const held = new Set<number>();

    const current = () => {
      const p = parsePitch(rootSel.value.replace('♯', '#').replace('♭', 'b'))!;
      return { pitch: p, octave: Number(octSel.value) };
    };

    function render() {
      const { pitch, octave } = current();
      root.querySelectorAll<HTMLElement>('[data-chord-ctl]').forEach((el) => (el.hidden = mode !== 'chord'));
      root.querySelectorAll<HTMLElement>('[data-scale-ctl]').forEach((el) => (el.hidden = mode !== 'scale'));
      let title: string;
      if (mode === 'chord') {
        const c = CHORDS.find((x) => x.id === chordSel.value)!;
        const inv = Math.min(Number(invSel.value), c.intervals.length - 1);
        notes = build(pitch, octave, c.intervals, inv);
        const bass = notes[0].pitch;
        title = `<strong>${esc(chordSymbol(pitch, c, inv ? bass : undefined))}</strong> <span>${esc(c.name)}${inv ? `, ${['', '1st', '2nd', '3rd'][inv]} inversion` : ''}</span>`;
        invSel.querySelectorAll('option').forEach((o) => (o.disabled = Number(o.value) >= c.intervals.length));
      } else {
        const s = SCALES.find((x) => x.id === scaleSel.value)!;
        notes = build(pitch, octave, [...s.intervals, [8, 12]]);
        title = `<strong>${esc(notes[0].name)} ${esc(s.name.replace(/ \(.*\)/, ''))}</strong> <span>${s.intervals.length} notes</span>`;
      }
      $('[data-symbol]').innerHTML = title;
      $('[data-notes]').innerHTML = `<caption class="visually-hidden">Notes</caption><tbody>
        <tr><th scope="row">Note</th>${notes.map((n) => `<td><strong>${esc(n.name)}</strong></td>`).join('')}</tr>
        <tr><th scope="row">Interval</th>${notes.map((n) => `<td>${esc(n.intervalName)}</td>`).join('')}</tr>
        <tr><th scope="row">MIDI</th>${notes.map((n) => `<td><code>${n.midi}</code></td>`).join('')}</tr>
        <tr><th scope="row">Octave</th>${notes.map((n) => `<td>${esc(noteName(n.midi).replace(/^[^\d-]+/, ''))}</td>`).join('')}</tr>
      </tbody>`;
      const ch = Number($<HTMLSelectElement>('[data-ch]').value) - 1;
      $('[data-bytes]').innerHTML = `Note On bytes (channel ${ch + 1}, velocity 100): <code>${esc(notes.map((n) => hexBytes([0x90 | ch, n.midi, 100])).join('  '))}</code>`;
      renderKeys();
      renderDiatonic();
    }

    function renderKeys() {
      const lo = Math.floor(Math.min(...notes.map((n) => n.midi)) / 12) * 12;
      const hi = Math.max(lo + 24, Math.ceil((Math.max(...notes.map((n) => n.midi)) + 1) / 12) * 12);
      const all = Array.from({ length: hi - lo + 1 }, (_, i) => lo + i);
      const whites = all.filter((n) => !isBlack(n));
      const ww = 100 / whites.length;
      const on = new Map(notes.map((n) => [n.midi, n]));
      $('[data-keys]').innerHTML = all
        .map((n) => {
          const wi = whites.filter((x) => x < n).length;
          const left = isBlack(n) ? wi * ww - ww * 0.32 : wi * ww;
          const hit = on.get(n);
          const heldCls = held.has(n) ? ' held' : '';
          return `<span class="key ${isBlack(n) ? 'black' : 'white'}${hit ? ' on' : ''}${heldCls}" style="left:${left}%;width:${isBlack(n) ? ww * 0.64 : ww}%">${hit ? `<b>${esc(hit.name)}</b>` : n % 12 === 0 ? `<i>C${n / 12 - 1}</i>` : ''}</span>`;
        })
        .join('');
    }

    function renderDiatonic() {
      const wrap = $('[data-diatonic-wrap]');
      if (mode !== 'scale') return void (wrap.hidden = true);
      const s = SCALES.find((x) => x.id === scaleSel.value)!;
      const list = diatonicChords(current().pitch, s, sevenths);
      wrap.hidden = !list.length;
      $('[data-diatonic]').innerHTML = list
        .map((d) => `<li><button type="button" class="cs-dchord" data-dia="${d.degree}"><span>${esc(d.roman)}</span><strong>${esc(d.symbol)}</strong></button></li>`)
        .join('');
    }

    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-dia]');
      if (!b) return;
      const s = SCALES.find((x) => x.id === scaleSel.value)!;
      const d = diatonicChords(current().pitch, s, sevenths)[Number(b.dataset.dia) - 1];
      // Play the chord from the scale without leaving it.
      const ns = build(d.root, Number(octSel.value) + (d.degree > 4 ? 0 : 0), d.chord.intervals);
      const base = notes[d.degree - 1].midi - ns[0].midi;
      play(ns.map((n) => n.midi + base), 'block');
      status.textContent = `${d.roman}: ${d.symbol} (${ns.map((n) => n.name).join(' ')})`;
    });

    /* ---------- Sound ---------- */
    const engine = () => {
      if (!ctx) {
        ctx = new AudioContext();
        sampler = new Sampler(ctx);
      }
      if (ctx.state === 'suspended') ctx.resume();
      const inst = insts.find((i) => i.id === soundSel.value) ?? insts[0];
      sampler!.inst = inst;
      return sampler!;
    };

    async function play(midis: number[], how: 'block' | 'arp') {
      if (soundSel.value === 'midi') {
        const out = getOut?.();
        if (!out) return void (status.textContent = 'Choose a MIDI output first.');
        const ch = Number($<HTMLSelectElement>('[data-ch]').value) - 1;
        const t0 = performance.now();
        midis.forEach((n, i) => {
          const at = t0 + (how === 'arp' ? i * 220 : 0);
          out.send([0x90 | ch, n, 100], at);
          out.send([0x80 | ch, n, 0], at + (how === 'arp' ? 200 : 1200));
        });
        status.textContent = `Sent ${midis.length} notes to ${out.name}.`;
        return;
      }
      const s = engine();
      const inst = s.inst!;
      if (!s.isLoaded(inst.id)) {
        status.textContent = `Loading ${inst.name} (${Math.round(inst.bytes / 1024)} KB)…`;
        try {
          await s.load(inst);
        } catch (err) {
          status.textContent = `Couldn't load ${inst.name}: ${(err as Error).message}`;
          return;
        }
        status.textContent = '';
      }
      const t = ctx!.currentTime + 0.03;
      midis.forEach((n, i) => {
        const at = t + (how === 'arp' ? i * 0.22 : 0);
        s.noteOn(n, 90, at, 1, { ignoreRange: true });
        setTimeout(() => s.noteOff(n), ((at - ctx!.currentTime) + (how === 'arp' ? 0.4 : 1.4)) * 1000);
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((b) =>
      b.addEventListener('click', () => play(notes.map((n) => n.midi), b.dataset.play as 'block' | 'arp')),
    );

    soundSel.addEventListener('change', async () => {
      const midi = soundSel.value === 'midi';
      $('[data-out-wrap]').hidden = !midi;
      $('[data-ch-wrap]').hidden = !midi;
      if (midi && !access) {
        try {
          access = await midiAccess();
          getOut = bindPortSelect<MIDIOutput>(access, $<HTMLSelectElement>('[data-out]'), 'outputs');
        } catch (err) {
          status.textContent = (err as Error).message;
          soundSel.value = insts[0].id;
          $('[data-out-wrap]').hidden = true;
          $('[data-ch-wrap]').hidden = true;
        }
      }
    });

    /* ---------- Chord detection from MIDI input ---------- */
    const detected = $('[data-detected]');
    const showDetected = () => {
      if (!held.size) return void (detected.innerHTML = '');
      const sorted = [...held].sort((a, b) => a - b);
      const m = identifyChord(sorted);
      const names = sorted.map((n) => noteName(n)).join(' ');
      detected.innerHTML = m.length
        ? `<strong>${esc(m[0].name)}</strong> <span>${esc(m[0].chord.name)} · ${esc(names)}</span>${m.length > 1 ? `<br><small>Also: ${m.slice(1, 4).map((x) => esc(x.name)).join(', ')}</small>` : ''}`
        : `<span>${esc(names)}</span> <small>(no chord match)</small>`;
      renderKeys();
    };
    $('[data-listen]').addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        access = await midiAccess();
      } catch (err) {
        detected.textContent = (err as Error).message;
        return;
      }
      const onMsg = (ev: MIDIMessageEvent) => {
        const d = ev.data;
        if (!d) return;
        const t = d[0] & 0xf0;
        if (t === 0x90 && d[2] > 0) held.add(d[1]);
        else if (t === 0x80 || (t === 0x90 && d[2] === 0)) held.delete(d[1]);
        else return;
        showDetected();
      };
      const wire = () => {
        const ins = [...access!.inputs.values()];
        ins.forEach((i) => (i.onmidimessage = onMsg));
        detected.textContent = ins.length ? `Listening to ${ins.map((i) => i.name).join(', ')}. Play a chord.` : 'No MIDI inputs found yet.';
      };
      access.addEventListener('statechange', wire);
      wire();
      btn.hidden = true;
    });

    /* ---------- Controls ---------- */
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as typeof mode;
        root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-sev]').forEach((b) =>
      b.addEventListener('click', () => {
        sevenths = b.dataset.sev === '1';
        root.querySelectorAll('[data-sev]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        renderDiatonic();
      }),
    );
    for (const el of [rootSel, octSel, chordSel, invSel, scaleSel, $<HTMLSelectElement>('[data-ch]')]) el.addEventListener('change', render);

    // Deep links: ?chord=Am7 style is overkill; support ?root=F&scale=dorian and ?root=E&chord=m7.
    const params = new URLSearchParams(location.search);
    if (params.get('root') && [...rootSel.options].some((o) => o.value === params.get('root'))) rootSel.value = params.get('root')!;
    if (params.get('scale') && SCALES.some((s) => s.id === params.get('scale'))) {
      mode = 'scale';
      scaleSel.value = params.get('scale')!;
      root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.mode === 'scale')));
    } else if (params.get('chord') && CHORDS.some((c) => c.id === params.get('chord'))) chordSel.value = params.get('chord')!;
    render();
  }
</script>

<style>
  .cs-mode {
    margin-bottom: 0.9rem;
  }
  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .cs-controls {
    display: grid;
    grid-template-columns: 7rem 6rem minmax(0, 1fr) 10rem;
    gap: 0.75rem;
    align-items: end;
  }
  .cs-controls label[hidden] {
    display: none;
  }
  .cs-out {
    margin-top: 1rem;
  }
  .cs-symbol {
    margin: 0 0 0.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .cs-symbol :global(strong) {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-size: 1.9rem;
  }
  .cs-symbol :global(span) {
    color: var(--ink-2);
  }
  .cs-notes-wrap {
    margin: 0.4rem 0 0.9rem;
  }
  .cs-notes :global(th) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    width: 5.5rem;
    background: var(--surface-2);
    white-space: nowrap;
  }
  .cs-notes :global(td) {
    text-align: center;
    min-width: 3rem;
  }
  .cs-keys {
    position: relative;
    height: 120px;
    margin-bottom: 0.6rem;
  }
  .cs-keys :global(.key) {
    position: absolute;
    top: 0;
    border: 1px solid var(--line-strong);
    border-radius: 0 0 5px 5px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.3rem;
    font-size: 0.68rem;
  }
  .cs-keys :global(.white) {
    height: 100%;
    background: #fbfaf6;
    z-index: 1;
    color: #3d3a33;
  }
  .cs-keys :global(.black) {
    height: 60%;
    background: #1d1c18;
    border-color: #1d1c18;
    z-index: 2;
    color: #fff;
  }
  .cs-keys :global(.white.on) {
    background: var(--accent-soft);
    box-shadow: inset 0 -5px 0 var(--accent);
  }
  .cs-keys :global(.black.on) {
    background: var(--accent);
  }
  .cs-keys :global(.held) {
    outline: 3px solid var(--data);
    outline-offset: -3px;
  }
  .cs-keys :global(b) {
    font-weight: 700;
  }
  .cs-keys :global(i) {
    font-style: normal;
    color: #645e52;
  }
  .cs-bytes {
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .cs-bytes :global(code) {
    overflow-wrap: anywhere;
  }
  .cs-play {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .cs-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .cs-inline select {
    width: auto;
    max-width: 13rem;
  }
  .cs-inline[hidden] {
    display: none;
  }
  .cs-status {
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .cs-h {
    font-size: 1rem;
    margin: 1.5rem 0 0.5rem;
  }
  .cs-dia {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
  }
  .cs-dia :global(.cs-dchord) {
    width: 100%;
    display: grid;
    gap: 0.1rem;
    justify-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    padding: 0.5rem 0.25rem;
    cursor: pointer;
    min-height: 3.5rem;
  }
  .cs-dia :global(.cs-dchord:hover) {
    border-color: var(--accent);
  }
  .cs-dia :global(.cs-dchord span) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .cs-hint {
    font-size: 0.88rem;
    color: var(--ink-2);
  }
  .cs-detected {
    margin-top: 0.6rem;
    min-height: 1.5em;
  }
  .cs-detected :global(strong) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin-right: 0.5rem;
  }
  @media (max-width: 720px) {
    .cs-controls {
      grid-template-columns: 1fr 1fr;
    }
    .cs-type {
      grid-column: 1 / -1;
    }
    .cs-dia {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
