---
/**
 * Wrapper for the hand-drawn inline SVG diagrams in src/components/diagrams/.
 *
 * Accessibility pattern (used by every diagram): the <svg> has role="img" and
 * aria-labelledby pointing at its own <title> and <desc>, which carry the full text
 * description. The visible <figcaption> is a short summary for sighted readers.
 *
 * Colors come only from the theme tokens in global.css via the classes below, so the
 * diagrams follow light/dark mode. Diagrams keep a minimum width so their text stays
 * legible; on narrow screens the frame scrolls sideways instead of shrinking the text.
 */
interface Props {
  /** Visible caption under the diagram. */
  caption: string;
  /** Smallest rendered width of the SVG in px before the frame starts to scroll. */
  minWidth: number;
  /** Largest rendered width of the SVG in px. Defaults to 1.2 × minWidth. */
  maxWidth?: number;
}

const { caption, minWidth, maxWidth = Math.round(minWidth * 1.2) } = Astro.props;
---

<figure class="diagram">
  <div class="diagram-scroll" data-label={`Diagram: ${caption}`} style={`--dg-min:${minWidth}px;--dg-max:${maxWidth}px`}>
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // Frames that actually overflow become keyboard-focusable so they can be scrolled with arrow keys.
  const update = (el: HTMLElement) => {
    const scrolls = el.scrollWidth > el.clientWidth + 1;
    if (scrolls && !el.hasAttribute('tabindex')) {
      el.tabIndex = 0;
      el.setAttribute('role', 'region');
      el.setAttribute('aria-label', el.dataset.label ?? 'Diagram');
    } else if (!scrolls && el.hasAttribute('tabindex')) {
      el.removeAttribute('tabindex');
      el.removeAttribute('role');
      el.removeAttribute('aria-label');
    }
  };
  // Fade the edge that has more to see, so it's obvious the diagram scrolls.
  const edges = (el: HTMLElement) => {
    const max = el.scrollWidth - el.clientWidth;
    el.classList.toggle('more-right', max > 1 && el.scrollLeft < max - 1);
    el.classList.toggle('more-left', el.scrollLeft > 1);
  };
  const frames = [...document.querySelectorAll<HTMLElement>('.diagram-scroll')];
  const observer = new ResizeObserver((entries) => entries.forEach((e) => (update(e.target as HTMLElement), edges(e.target as HTMLElement))));
  for (const el of frames) {
    observer.observe(el);
    el.addEventListener('scroll', () => edges(el), { passive: true });
  }
</script>

<style>
  .diagram {
    margin: var(--s-5) 0 var(--s-5);
  }
  .diagram-scroll {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--s-3) var(--s-3);
  }
  .diagram-scroll.more-right {
    mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
  }
  .diagram-scroll.more-left {
    mask-image: linear-gradient(to left, #000 calc(100% - 40px), transparent);
  }
  .diagram-scroll.more-left.more-right {
    mask-image: linear-gradient(to right, transparent, #000 40px, #000 calc(100% - 40px), transparent);
  }
  .diagram-scroll > :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    min-width: var(--dg-min);
    max-width: var(--dg-max);
    margin: 0 auto;
    overflow: visible;
  }
  figcaption {
    margin-top: var(--s-2);
    max-width: var(--measure);
    font-size: var(--t-md);
    line-height: 1.45;
    color: var(--muted);
  }

  /* ---------- Shared SVG vocabulary (all colors are theme tokens) ---------- */
  .diagram :global(svg text) {
    font-family: var(--font-text);
    font-size: var(--t-sm);
    fill: var(--ink);
  }
  .diagram :global(svg .mono) {
    font-family: var(--font-mono);
  }
  .diagram :global(svg .disp) {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-tracking);
    text-transform: var(--label-case);
    font-size: var(--t-xs);
  }
  .diagram :global(svg .sm) {
    font-size: var(--t-xs);
  }
  .diagram :global(svg .md) {
    font-size: var(--t-md);
  }
  .diagram :global(svg .lg) {
    font-size: var(--t-base);
  }
  .diagram :global(svg .xl) {
    font-size: var(--t-base);
  }
  .diagram :global(svg .b) {
    font-weight: 700;
  }
  .diagram :global(svg .mid) {
    text-anchor: middle;
  }
  .diagram :global(svg .end) {
    text-anchor: end;
  }
  .diagram :global(svg .mu) {
    fill: var(--muted);
  }
  .diagram :global(svg .i2) {
    fill: var(--ink-2);
  }
  .diagram :global(svg .c-s) {
    fill: var(--accent);
  }
  .diagram :global(svg .c-d) {
    fill: var(--data);
  }
  .diagram :global(svg .c-m) {
    fill: var(--meta);
  }
  /* Time (delta-times): a fourth category, drawn in the chart hue rather than the warning amber. */
  .diagram :global(svg .c-w) {
    fill: var(--sky);
  }
  .diagram :global(svg .on-solid) {
    fill: var(--surface);
  }

  /* Boxes: soft fill + matching stroke, like the byte chips. */
  .diagram :global(svg :is(.box-s, .box-d, .box-m, .box-w, .box-n, .box-b, .solid-s, .solid-d, .solid-m, .ghost)) {
    stroke-width: 1.25;
  }
  .diagram :global(svg .box-s) {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }
  .diagram :global(svg .box-d) {
    fill: var(--data-soft);
    stroke: var(--data);
  }
  .diagram :global(svg .box-m) {
    fill: var(--meta-soft);
    stroke: var(--meta);
  }
  .diagram :global(svg .box-w) {
    fill: color-mix(in srgb, var(--sky) 14%, var(--surface));
    stroke: var(--sky);
  }
  .diagram :global(svg .box-n) {
    fill: var(--surface-2);
    stroke: var(--line-strong);
  }
  .diagram :global(svg .box-b) {
    fill: var(--bg);
    stroke: var(--line-strong);
  }
  .diagram :global(svg .solid-s) {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .diagram :global(svg .solid-d) {
    fill: var(--data);
    stroke: var(--data);
  }
  .diagram :global(svg .solid-m) {
    fill: var(--meta);
    stroke: var(--meta);
  }
  .diagram :global(svg .ghost) {
    fill: none;
    stroke: var(--muted);
    stroke-dasharray: 4 3;
  }

  /* Lines and arrowheads. */
  .diagram :global(svg :is(.ln, .ln-mu, .ln-s, .ln-d, .ln-m)) {
    fill: none;
    stroke-width: 1.25;
  }
  .diagram :global(svg .ln) {
    stroke: var(--line-strong);
  }
  .diagram :global(svg .ln-mu) {
    stroke: var(--muted);
  }
  .diagram :global(svg .ln-s) {
    stroke: var(--accent);
  }
  .diagram :global(svg .ln-d) {
    stroke: var(--data);
  }
  .diagram :global(svg .ln-m) {
    stroke: var(--meta);
  }
  .diagram :global(svg .dash) {
    stroke-dasharray: 4 3;
  }
  .diagram :global(svg .tick) {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .diagram :global(svg .head-mu) {
    fill: var(--muted);
  }
  .diagram :global(svg .head-d) {
    fill: var(--data);
  }
  .diagram :global(svg .head-m) {
    fill: var(--meta);
  }
</style>
