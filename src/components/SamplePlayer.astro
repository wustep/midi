---
import Icon from './Icon.astro';
import instruments from '../../data/samples.json';

const kb = (n: number) => `${Math.round(n / 1024)} KB`;
---

<section class="widget sp" data-sp aria-labelledby="sp-title">
  <div class="widget-head">
    <h2 class="widget-title" id="sp-title">Play an instrument</h2>
    <span class="widget-tag">mouse · touch · keyboard · Web MIDI</span>
  </div>

  <fieldset class="sp-insts">
    <legend class="field-label">Instrument</legend>
    <div class="sp-inst-grid">
      {
        instruments.map((inst, i) => (
          <label class="sp-inst">
            <input type="radio" name="sp-inst" value={inst.id} checked={i === 0} />
            <span class="sp-inst-body">
              <span class="sp-family">{inst.family}</span>
              <strong>{inst.name}</strong>
              <span class="sp-meta">
                {inst.notes.length} samples · {kb(inst.bytes)} · {inst.license.replace(/-/g, ' ').replace('CC0 1.0', 'CC0')}
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="sp-bar">
    <p class="sp-status" role="status" aria-live="polite" data-status>Samples load when you pick an instrument or play a note.</p>
    <div class="sp-controls">
      <button type="button" class="btn btn-sm" data-oct="-1" aria-label="Octave down">Oct −</button>
      <span class="sp-oct" data-oct-label aria-live="polite">C3–C5</span>
      <button type="button" class="btn btn-sm" data-oct="1" aria-label="Octave up">Oct +</button>
      <button type="button" class="chip" data-sustain aria-pressed="false">Sustain</button>
      <label class="sp-vel">
        <span>Velocity</span>
        <input type="range" min="1" max="127" value="96" data-vel aria-label="Velocity" />
      </label>
    </div>
  </div>

  <p class="sp-rotate">Turn your phone sideways for more keys.</p>
  <div class="sp-stage" data-stage>
    <div class="sp-keys" data-keys role="group" aria-label="Piano keyboard"></div>
    <div class="sp-pads" data-pads role="group" aria-label="Drum pads" hidden></div>
  </div>

  <div class="sp-foot">
    <p class="sp-hint" data-hint>
      Computer keys: <kbd>A</kbd> <kbd>W</kbd> <kbd>S</kbd> <kbd>E</kbd> <kbd>D</kbd> … <kbd>K</kbd> play from C, <kbd>Z</kbd> / <kbd>X</kbd>
      shift octaves, hold <kbd>Space</kbd> for sustain.
    </p>
    <div class="sp-midi">
      <button type="button" class="btn" data-midi><Icon name="plug" size={18} /><span data-label>Connect a MIDI keyboard</span></button>
      <span class="sp-midi-status" data-midi-status role="status"></span>
    </div>
  </div>
  <p class="sp-attr" data-attr></p>
</section>

<script>
  import { Sampler, KEYMAP, playable, type Instrument } from '../lib/sampler';
  import { noteName } from '../lib/midi';
  import { midiAccess } from '../lib/webmidi';
  import data from '../../data/samples.json';

  const insts = data as Instrument[];
  const isBlack = (n: number) => [1, 3, 6, 8, 10].includes(n % 12);

  for (const root of document.querySelectorAll<HTMLElement>('[data-sp]')) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const status = $('[data-status]');
    const keysEl = $('[data-keys]');
    const padsEl = $('[data-pads]');
    const vel = $<HTMLInputElement>('[data-vel]');
    const sustainBtn = $<HTMLButtonElement>('[data-sustain]');
    let ctx: AudioContext | undefined;
    let sampler: Sampler | undefined;
    let inst = insts[0];
    let base = 48; // lowest C shown on screen
    let octaves = 2;
    const down = new Map<number, number>(); // note -> count of sources holding it (pointer, key, MIDI)

    const engine = () => {
      if (!ctx) {
        ctx = new AudioContext();
        sampler = new Sampler(ctx);
        sampler.inst = inst;
      }
      if (ctx.state === 'suspended') ctx.resume();
      return sampler!;
    };

    async function ensureLoaded() {
      const s = engine();
      if (s.isLoaded(inst.id)) return;
      const which = inst;
      status.textContent = `Loading ${which.name} (${Math.round(which.bytes / 1024)} KB)…`;
      try {
        await s.load(which, (d, t) => {
          if (inst === which) status.textContent = `Loading ${which.name}: ${d}/${t} samples…`;
        });
        if (inst === which) status.textContent = which.drumMap ? `${which.name} ready: ${which.notes.length} pieces on the General MIDI drum keys.` : `${which.name} ready: ${which.notes.length} samples, repitched across ${noteName(which.range[0])}–${noteName(which.range[1])}.`;
      } catch (e) {
        if (inst === which) status.textContent = `Couldn't load ${which.name}: ${(e as Error).message}. Try again.`;
      }
    }

    /* ---------- Notes ---------- */
    const keyEl = (n: number) => root.querySelector<HTMLElement>(`[data-note="${n}"]`);
    function press(n: number, v = Number(vel.value)) {
      const count = down.get(n) ?? 0;
      down.set(n, count + 1);
      keyEl(n)?.classList.add('on');
      const s = engine();
      if (!s.isLoaded(inst.id)) ensureLoaded();
      s.noteOn(n, v);
    }
    function release(n: number) {
      const count = (down.get(n) ?? 1) - 1;
      if (count > 0) down.set(n, count);
      else {
        down.delete(n);
        keyEl(n)?.classList.remove('on');
        sampler?.noteOff(n);
      }
    }
    function setSustain(on: boolean) {
      sustainBtn.setAttribute('aria-pressed', String(on));
      engine().setSustain(on);
    }
    sustainBtn.addEventListener('click', () => setSustain(sustainBtn.getAttribute('aria-pressed') !== 'true'));

    /* ---------- Rendering ---------- */
    function fitOctaves() {
      const w = keysEl.clientWidth || root.clientWidth;
      octaves = w < 420 ? 1 : w < 700 ? 2 : w < 1000 ? 3 : 4;
    }

    function render() {
      const drums = Boolean(inst.drumMap);
      keysEl.hidden = drums;
      padsEl.hidden = !drums;
      root.querySelectorAll<HTMLButtonElement>('[data-oct]').forEach((b) => (b.disabled = drums));
      $('[data-oct-label]').textContent = drums ? 'Drum kit' : `${noteName(base)}–${noteName(base + octaves * 12)}`;
      $('[data-hint]').innerHTML = drums
        ? 'Computer keys: <kbd>A</kbd> <kbd>W</kbd> <kbd>S</kbd> … play the pads in order. A MIDI keyboard plays the General MIDI drum keys.'
        : 'Computer keys: <kbd>A</kbd> <kbd>W</kbd> <kbd>S</kbd> <kbd>E</kbd> <kbd>D</kbd> … <kbd>K</kbd> play from C, <kbd>Z</kbd> / <kbd>X</kbd> shift octaves, hold <kbd>Space</kbd> for sustain.';
      $('[data-attr]').innerHTML = `Sound: ${inst.attribution}. <a href="${inst.sourceUrl}">Source</a> · <a href="/sounds/${inst.id}/LICENSE.txt">License &amp; changes</a>`;
      if (drums) {
        padsEl.innerHTML = Object.entries(inst.drumMap!)
          .map(([n, name], i) => `<button type="button" class="pad" data-note="${n}" aria-label="${name} (key ${n})"><span>${name}</span><small>${n}${i < 18 ? ` · ${Object.keys(KEYMAP)[i].replace('Key', '').replace('Semicolon', ';').replace('Quote', "'")}` : ''}</small></button>`)
          .join('');
        return;
      }
      const notes = Array.from({ length: octaves * 12 + 1 }, (_, i) => base + i);
      const whites = notes.filter((n) => !isBlack(n));
      const ww = 100 / whites.length;
      keysEl.innerHTML = notes
        .map((n) => {
          const wi = whites.filter((x) => x < n).length;
          const left = isBlack(n) ? wi * ww - ww * 0.32 : wi * ww;
          const ok = playable(inst, n);
          const label = n % 12 === 0 ? `<span class="lbl">${noteName(n)}</span>` : '';
          return `<button type="button" class="key ${isBlack(n) ? 'black' : 'white'}${ok ? '' : ' off'}" data-note="${n}" style="left:${left}%;width:${isBlack(n) ? ww * 0.64 : ww}%" aria-label="${noteName(n)}${ok ? '' : ' (outside this instrument’s range)'}" tabindex="-1">${label}</button>`;
        })
        .join('');
      for (const n of down.keys()) keyEl(n)?.classList.add('on');
    }

    /* ---------- Pointer input (mouse, touch, pen) with glissando ---------- */
    const pointers = new Map<number, number>();
    const noteAt = (x: number, y: number) => {
      const el = document.elementFromPoint(x, y)?.closest<HTMLElement>('[data-note]');
      return el && root.contains(el) ? Number(el.dataset.note) : undefined;
    };
    const velFromY = (el: HTMLElement, y: number) => {
      // Lower on the key = louder, like striking nearer the front edge.
      const r = el.getBoundingClientRect();
      return Math.round(40 + Math.min(1, Math.max(0, (y - r.top) / r.height)) * 87);
    };
    const stage = $('[data-stage]');
    stage.addEventListener('pointerdown', (e) => {
      const n = noteAt(e.clientX, e.clientY);
      if (n === undefined) return;
      e.preventDefault();
      stage.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, n);
      const el = keyEl(n)!;
      press(n, e.pointerType === 'mouse' && !inst.drumMap ? velFromY(el, e.clientY) : Number(vel.value));
    });
    stage.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      const n = noteAt(e.clientX, e.clientY);
      const prev = pointers.get(e.pointerId)!;
      if (n === undefined || n === prev || inst.drumMap) return;
      release(prev);
      pointers.set(e.pointerId, n);
      press(n);
    });
    const end = (e: PointerEvent) => {
      const n = pointers.get(e.pointerId);
      if (n === undefined) return;
      pointers.delete(e.pointerId);
      release(n);
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    // Keyboard access for the on-screen keys: Enter/Space on a focused pad.
    stage.addEventListener('keydown', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-note]');
      if (!el || (e.key !== 'Enter' && e.key !== ' ') || e.repeat) return;
      e.preventDefault();
      e.stopPropagation();
      const n = Number(el.dataset.note);
      press(n);
      setTimeout(() => release(n), 300);
    });

    /* ---------- Computer keyboard ---------- */
    const held = new Map<string, number>();
    const typing = (t: EventTarget | null) => t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && (t as HTMLInputElement).type !== 'radio' && (t as HTMLInputElement).type !== 'range');
    document.addEventListener('keydown', (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || typing(e.target)) return;
      if (!root.isConnected) return;
      if (e.code === 'Space' && !(e.target instanceof HTMLButtonElement || e.target instanceof HTMLInputElement)) {
        e.preventDefault();
        if (!e.repeat) setSustain(true);
        return;
      }
      if (e.repeat) return;
      if ((e.code === 'KeyZ' || e.code === 'KeyX') && !inst.drumMap) {
        base = Math.max(12, Math.min(96, base + (e.code === 'KeyZ' ? -12 : 12)));
        render();
        return;
      }
      const off = KEYMAP[e.code];
      if (off === undefined) return;
      let n: number;
      if (inst.drumMap) {
        const pads = Object.keys(inst.drumMap);
        if (off >= pads.length) return;
        n = Number(pads[off]);
      } else n = base + 12 + off - (octaves === 1 ? 12 : 0);
      e.preventDefault();
      held.set(e.code, n);
      press(n);
    });
    document.addEventListener('keyup', (e) => {
      if (e.code === 'Space' && sustainBtn.getAttribute('aria-pressed') === 'true' && !(e.target instanceof HTMLButtonElement || e.target instanceof HTMLInputElement)) {
        setSustain(false);
        return;
      }
      const n = held.get(e.code);
      if (n === undefined) return;
      held.delete(e.code);
      release(n);
    });
    window.addEventListener('blur', () => {
      for (const n of held.values()) release(n);
      held.clear();
    });

    /* ---------- Octave buttons ---------- */
    root.querySelectorAll<HTMLButtonElement>('[data-oct]').forEach((b) =>
      b.addEventListener('click', () => {
        base = Math.max(12, Math.min(96, base + Number(b.dataset.oct) * 12));
        render();
      }),
    );

    /* ---------- Instrument choice ---------- */
    root.querySelectorAll<HTMLInputElement>('input[name="sp-inst"]').forEach((r) =>
      r.addEventListener('change', () => {
        sampler?.allOff();
        down.clear();
        inst = insts.find((i) => i.id === r.value)!;
        if (sampler) sampler.inst = inst;
        // Center the view on the instrument's range.
        if (!inst.drumMap) {
          const mid = (inst.range[0] + inst.range[1]) / 2;
          base = Math.max(12, Math.min(96, Math.round((mid - (octaves * 12) / 2) / 12) * 12));
        }
        render();
        ensureLoaded();
      }),
    );

    /* ---------- Web MIDI input ---------- */
    const midiBtn = $<HTMLButtonElement>('[data-midi]');
    const midiStatus = $('[data-midi-status]');
    midiBtn.addEventListener('click', async () => {
      let access: MIDIAccess;
      try {
        access = await midiAccess();
      } catch (err) {
        midiStatus.textContent = (err as Error).message;
        return;
      }
      const onMessage = (ev: MIDIMessageEvent) => {
        const d = ev.data;
        if (!d || d.length < 2) return;
        const type = d[0] & 0xf0;
        if (type === 0x90 && d[2] > 0) press(d[1], d[2]);
        else if (type === 0x80 || (type === 0x90 && d[2] === 0)) release(d[1]);
        else if (type === 0xb0 && d[1] === 64) setSustain(d[2] >= 64);
      };
      const wire = () => {
        const ins = [...access.inputs.values()];
        for (const i of ins) i.onmidimessage = onMessage;
        midiStatus.textContent = ins.length ? `Listening to ${ins.map((i) => i.name).join(', ')}.` : 'No MIDI inputs found. Plug one in; it will connect automatically.';
      };
      access.onstatechange = wire;
      wire();
      midiBtn.hidden = true;
      engine();
      ensureLoaded();
    });

    fitOctaves();
    render();
    new ResizeObserver(() => {
      const before = octaves;
      fitOctaves();
      if (before !== octaves) render();
    }).observe(root);
  }
</script>

<style>
  .sp-insts {
    border: 0;
    padding: 0;
    margin: 0 0 var(--s-4);
    /* Fieldsets default to min-width: min-content, which would let the instrument strip widen the page. */
    min-width: 0;
  }
  .sp-inst-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 45%), 1fr));
    gap: var(--s-2);
  }
  .sp-inst {
    position: relative;
    cursor: pointer;
  }
  .sp-inst input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .sp-inst-body {
    display: grid;
    gap: var(--s-0);
    height: 100%;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .sp-inst input:checked + .sp-inst-body {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: var(--accent-soft);
  }
  .sp-inst input:focus-visible + .sp-inst-body {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .sp-family {
    font-family: var(--font-label);
    font-stretch: var(--label-stretch);
    font-weight: var(--label-weight);
    letter-spacing: var(--label-tracking);
    text-transform: var(--label-case);
    font-size: var(--t-2xs);
    color: var(--muted);
  }
  .sp-meta {
    font-size: var(--t-xs);
    color: var(--ink-2);
  }
  .sp-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-bottom: var(--s-3);
  }
  .sp-status {
    margin: 0;
    font-size: var(--t-md);
    color: var(--ink-2);
    min-height: 1.4em;
  }
  .sp-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-2);
  }
  .sp-oct {
    font-family: var(--font-mono);
    font-size: var(--t-md);
    min-width: 5.5rem;
    text-align: center;
  }
  .sp-vel {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-md);
    font-weight: 600;
    color: var(--ink-2);
  }
  .sp-vel input {
    width: 7rem;
    accent-color: var(--accent);
  }
  .sp-stage {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .sp-keys {
    position: relative;
    height: clamp(150px, 22vw, 210px);
  }
  .sp-keys :global(.key) {
    position: absolute;
    top: 0;
    border: 1px solid var(--key-edge);
    border-radius: 0 0 var(--r-sm) var(--r-sm);
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }
  .sp-keys :global(.white) {
    height: 100%;
    background: var(--key-w);
    z-index: 1;
  }
  .sp-keys :global(.black) {
    height: 62%;
    background: var(--key-b);
    border-color: var(--key-b);
    z-index: 2;
  }
  .sp-keys :global(.key.off) {
    opacity: 0.45;
  }
  .sp-keys :global(.white.on) {
    background: var(--key-on);
    box-shadow: inset 0 -6px 0 var(--accent);
  }
  .sp-keys :global(.white.on .lbl) {
    color: var(--key-on-label);
  }
  .sp-keys :global(.black.on) {
    background: var(--accent);
  }
  .sp-keys :global(.lbl) {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    color: var(--key-label);
    padding-bottom: var(--s-2);
    pointer-events: none;
  }
  .sp-pads {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--s-2);
  }
  .sp-pads :global(.pad) {
    display: grid;
    gap: var(--s-1);
    place-content: center;
    min-height: 5.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-1);
    cursor: pointer;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }
  .sp-pads :global(.pad span) {
    font-weight: 700;
    font-size: var(--t-md);
  }
  .sp-pads :global(.pad small) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
  }
  .sp-pads :global(.pad.on) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .sp-pads :global(.pad.on small) {
    color: inherit;
  }
  .sp-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-4);
  }
  .sp-hint {
    margin: 0;
    font-size: var(--t-md);
    color: var(--muted);
  }
  .sp-midi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }
  .sp-midi-status {
    font-size: var(--t-md);
    color: var(--ink-2);
  }
  .sp-attr {
    margin: var(--s-3) 0 0;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .sp-rotate {
    display: none;
  }
  @media (max-width: 520px) {
    /* One swipeable row of instruments so the keyboard stays near the top. */
    .sp-inst-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      gap: var(--s-2);
      padding-bottom: var(--s-2);
      margin: 0 calc(-1 * var(--s-4));
      padding-inline: var(--s-4);
      scrollbar-width: none;
      mask-image: linear-gradient(to right, #000 calc(100% - var(--s-6)), transparent);
    }
    .sp-inst {
      flex: 0 0 8.5rem;
      scroll-snap-align: start;
    }
    .sp-keys {
      height: 200px;
    }
    .sp-inst-body {
      padding: var(--s-2) var(--s-2);
    }
    .sp-family {
      display: none;
    }
    .sp-inst strong {
      font-size: var(--t-ui);
    }
    .sp-meta {
      font-size: var(--t-2xs);
    }
    .sp-vel input {
      width: 5.5rem;
    }
  }
  @media (max-width: 520px) and (orientation: portrait) and (pointer: coarse) {
    .sp-rotate {
      display: block;
      font-size: var(--t-sm);
      color: var(--muted);
      margin: 0 0 var(--s-2);
    }
  }
  @media (pointer: coarse) {
    .sp-hint {
      display: none;
    }
  }
</style>
