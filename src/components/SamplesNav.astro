---
import sources from '../../data/sample-sources.json';
interface Props {
  page: 'play' | 'sources';
}
const { page } = Astro.props;
---

<nav class="subnav" aria-label="Samples">
  <a href="/samples/" aria-current={page === 'play' ? 'page' : undefined}>Play instruments</a>
  <a href="/samples/sources/" aria-current={page === 'sources' ? 'page' : undefined}>Sound libraries <span class="n">{sources.length}</span></a>
</nav>
