---
/** A consistent "Keyboard shortcuts" disclosure for tool pages. Keys use "+" for chords, "/" for alternatives. */
interface Props {
  items: [keys: string, action: string][];
}
const { items } = Astro.props;
const render = (keys: string) => keys.split(' / ').map((alt) => alt.split('+').map((k) => k.trim()));
---

<details class="shortcuts">
  <summary>Keyboard shortcuts</summary>
  <dl>
    {
      items.map(([keys, action]) => (
        <div>
          <dt>
            {render(keys).map((alt, i) => (
              <>
                {i > 0 && <span class="or">or</span>}
                {alt.map((k, j) => (
                  <>
                    {j > 0 && '+'}
                    <kbd>{k}</kbd>
                  </>
                ))}
              </>
            ))}
          </dt>
          <dd>{action}</dd>
        </div>
      ))
    }
  </dl>
</details>

<style>
  .shortcuts {
    margin: calc(-1 * var(--s-4)) 0 var(--s-5);
    font-size: var(--t-md);
  }
  summary {
    cursor: pointer;
    color: var(--ink-2);
    font-weight: var(--w-semibold);
    min-height: var(--h-md);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    list-style: none;
    border-radius: var(--r-sm);
    transition: color var(--d-fast) ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Same chevron as fold groups: points right when closed, down when open. */
  summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-1px) rotate(-45deg);
    transition: transform var(--d-base) var(--ease-out);
  }
  .shortcuts[open] summary::before {
    transform: translateY(-3px) rotate(45deg);
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      color: var(--ink);
    }
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--s-2) var(--s-5);
    margin: var(--s-1) 0 0;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  dl div {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
  }
  dt {
    flex: 0 0 auto;
    min-width: 6.5rem;
    white-space: nowrap;
  }
  dd {
    margin: 0;
    color: var(--ink-2);
  }
  .or {
    margin: 0 var(--s-1);
    color: var(--muted);
    font-size: 0.8em;
  }
  @media (pointer: coarse) {
    .shortcuts {
      display: none;
    }
  }
</style>
