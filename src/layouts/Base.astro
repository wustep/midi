---
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';
import SearchPalette from '../components/SearchPalette.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** Path of the active top-level section, e.g. "/docs" */
  section?: string;
}

const { title, description = 'The field guide to MIDI: protocol docs, interactive tools, and a curated catalog of open-source MIDI libraries.', section } = Astro.props;
const fullTitle = title === 'MIDI Field Guide' ? title : `${title} · MIDI Field Guide`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// One social card per section, rendered at build time from live counts (src/pages/og/[section].png.ts).
const OG: Record<string, string> = { '/docs': 'docs', '/tools': 'tools', '/reader': 'reader', '/libraries': 'libraries', '/samples': 'samples', '/community': 'community' };
const ogImage = new URL(`/og/${(section && OG[section]) || 'home'}.png`, Astro.site);

const nav = [
  { href: '/docs/', label: 'Docs', key: '/docs' },
  { href: '/libraries/', label: 'Libraries', key: '/libraries' },
  { href: '/reader/', label: 'Reader', key: '/reader' },
  { href: '/tools/', label: 'Tools', key: '/tools' },
  { href: '/samples/', label: 'Samples', key: '/samples' },
  { href: '/community/', label: 'Community', key: '/community' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/archivo-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11110f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MIDI Field Guide" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`MIDI Field Guide: ${title === 'MIDI Field Guide' ? 'the field guide to MIDI' : title}`} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/" aria-label="MIDI Field Guide, home">
          <Icon name="din" size={30} class="din" />
          <span class="wordmark-text">MIDI<span class="wordmark-sub">Field Guide</span></span>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
          <!-- The menu icon from the set (icons.mjs "menu"), split into three paths so it can morph into a close icon. -->
          <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
            ><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ><path class="m1" d="M4 7h16"></path><path class="m2" d="M4 12h16"></path><path class="m3" d="M4 17h16"></path></g
            ></svg
          >
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-actions">
          <a class="search-btn" href="/search/" data-open-search aria-label="Search" aria-keyshortcuts="Control+K Meta+K /">
            <Icon name="search" size={18} />
            <span class="search-label">Search</span>
            <kbd class="search-kbd" data-mod>⌘K</kbd>
          </a>
          <a class="icon-btn" href="https://github.com/wustep/midi" aria-label="Source on GitHub" title="Source on GitHub">
            <Icon name="code" size={20} />
          </a>
          <button class="icon-btn theme-toggle" type="button" aria-label="Toggle color theme">
            <Icon name="sun" size={20} class="i-sun" />
            <Icon name="moon" size={20} class="i-moon" />
          </button>
        </div>
      </div>
    </header>

    <SearchPalette />
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          <strong>MIDI Field Guide</strong> is an open, community-maintained reference. Code
          <a href="https://github.com/wustep/midi/blob/main/LICENSE">MIT</a>, content and data
          <a href="https://github.com/wustep/midi/blob/main/LICENSE-CC0">CC0</a>.
        </p>
        <nav class="footer-links" aria-label="Site">
          <a href="/search/">Search</a>
          <a href="/docs/glossary/">Glossary</a>
          <a href="/design/">Design system</a>
          <a href="https://github.com/wustep/midi/blob/main/CONTRIBUTING.md">Contribute on GitHub</a>
        </nav>
        <p class="fineprint">
          MIDI is a trademark of the MIDI Manufacturers Association. This site is independent and not affiliated with
          the MMA or AMEI. Always check the official specifications at
          <a href="https://midi.org/specs">midi.org/specs</a>.
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const sync = () => btn?.setAttribute('aria-pressed', String(current() === 'dark'));
      sync();

      // Show Ctrl K instead of ⌘K outside Apple platforms.
      if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) document.querySelectorAll('[data-mod]').forEach((k) => (k.textContent = 'Ctrl K'));

      // Phone menu: the primary nav collapses behind a button.
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const header = document.querySelector<HTMLElement>('.site-header');
      const setMenu = (open: boolean) => {
        menuBtn?.setAttribute('aria-expanded', String(open));
        header?.classList.toggle('menu-open', open);
      };
      menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header?.classList.contains('menu-open')) {
          setMenu(false);
          menuBtn?.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (header?.classList.contains('menu-open') && !header.contains(e.target as Node)) setMenu(false);
      });
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        sync();
      });

      // The header shows its hairline only once content scrolls under it.
      const onScroll = () => root.toggleAttribute('data-scrolled', scrollY > 4);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Long grouped lists fold on phones: <details data-fold-phone open> starts closed there.
      if (matchMedia('(max-width: 720px)').matches) {
        document.querySelectorAll<HTMLDetailsElement>('details[data-fold-phone]').forEach((d) => (d.open = false));
      }
      // Opening a #link to something inside a folded group opens the group.
      const openTarget = () => {
        if (!location.hash) return;
        document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest('details')?.setAttribute('open', '');
      };
      addEventListener('hashchange', openTarget);
      openTarget();

      // Wide tables and code blocks scroll sideways on small screens. Make the ones that
      // actually overflow keyboard-focusable, labelled by their caption or nearest heading.
      const usedLabels = new Map<string, number>();
      const labelFor = (el: HTMLElement) => {
        const kind = el.tagName === 'PRE' ? 'Code' : 'Table';
        let ctx = el.querySelector('caption')?.textContent?.trim();
        for (let n: Element | null = el; !ctx && n && n !== document.body; n = n.previousElementSibling ?? n.parentElement) {
          if (/^H[2-4]$/.test(n.tagName) && n !== el) ctx = n.textContent?.trim();
        }
        const base = ctx ? `${kind}: ${ctx}` : kind;
        const count = (usedLabels.get(base) ?? 0) + 1;
        usedLabels.set(base, count);
        return count > 1 ? `${base} (${count})` : base;
      };
      const update = (el: HTMLElement) => {
        const scrolls = el.scrollWidth > el.clientWidth || el.scrollHeight > el.clientHeight;
        const auto = 'autoFocusable' in el.dataset;
        if (scrolls && !auto && !el.hasAttribute('tabindex')) {
          el.dataset.autoFocusable = '';
          el.tabIndex = 0;
          el.setAttribute('role', 'region');
          el.setAttribute('aria-label', el.dataset.label ??= labelFor(el));
        } else if (!scrolls && auto) {
          delete el.dataset.autoFocusable;
          el.removeAttribute('tabindex');
          el.removeAttribute('role');
          el.removeAttribute('aria-label');
        }
      };
      // The far-edge fade on a scrolling box goes away once it's scrolled to the end.
      const atEnd = (el: HTMLElement) => el.toggleAttribute('data-scroll-end', el.scrollLeft + el.clientWidth >= el.scrollWidth - 2);
      const observer = new ResizeObserver((entries) => entries.forEach((e) => (update(e.target as HTMLElement), atEnd(e.target as HTMLElement))));
      const boxes = [...document.querySelectorAll<HTMLElement>('.table-wrap, pre')].filter(
        // Leave boxes that already manage their own focus (e.g. the note table widget).
        (el) => !el.hasAttribute('tabindex') || 'autoFocusable' in el.dataset,
      );
      for (const el of boxes) {
        observer.observe(el);
        el.addEventListener('scroll', () => atEnd(el), { passive: true });
      }
      // Web fonts change content width without resizing the box, so check again once they load.
      document.fonts?.ready.then(() => boxes.forEach(update));
    </script>
  </body>
</html>

<style>
  /* Header: a translucent material that content scrolls under. The hairline appears only once
     something is underneath it (data-scrolled), instead of a permanent divider. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* Opaque enough that text scrolling underneath never competes with the nav labels. */
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: saturate(1.6) blur(20px);
    -webkit-backdrop-filter: saturate(1.6) blur(20px);
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow var(--d-base) ease, background-color var(--d-base) ease;
  }
  :global(html[data-scrolled]) .site-header {
    box-shadow: 0 1px 0 var(--line);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .site-header-inner {
    max-width: var(--w-page);
    min-height: var(--header-h);
    margin: 0 auto;
    padding: var(--s-2) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
    border-radius: var(--r-sm);
  }
  .wordmark :global(.din) {
    --pin: var(--accent);
    transition: transform var(--d-slow) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wordmark:hover :global(.din) {
      transform: rotate(-12deg);
    }
  }
  .wordmark-text {
    font-family: var(--font-display);
    font-weight: var(--w-black);
    font-stretch: 125%;
    font-size: var(--t-lg);
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .wordmark-sub {
    font-weight: var(--w-medium);
    font-stretch: 100%;
    font-size: var(--t-sm);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--muted);
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    gap: var(--s-0);
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    position: relative;
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-sm);
    color: var(--ink-2);
    text-decoration: none;
    font-weight: var(--w-semibold);
    font-size: var(--t-ui);
    transition: background-color var(--d-fast) ease, color var(--d-fast) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover {
      background: var(--surface-2);
      color: var(--ink);
    }
  }
  /* Active section: ink text plus a short accent bar under the label, not a filled tab. */
  .site-nav a[aria-current='page'] {
    color: var(--ink);
  }
  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 1px;
    height: 2px;
    border-radius: var(--r-pill);
    background: var(--accent);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--h-md);
    min-width: 12rem;
    padding: 0 var(--s-2) 0 var(--s-3);
    margin-right: var(--s-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--surface-sunken);
    box-shadow: var(--shadow-inset);
    color: var(--muted);
    text-decoration: none;
    font-size: var(--t-md);
    transition: border-color var(--d-fast) ease, color var(--d-fast) ease, transform var(--d-press) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .search-btn:hover {
      border-color: var(--control);
      color: var(--ink);
    }
  }
  .search-btn:active {
    transform: scale(var(--press-scale));
  }
  .search-kbd {
    margin-left: auto;
    font-size: var(--t-2xs);
  }
  .theme-toggle :global(.i-moon) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.i-sun) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.i-sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.i-moon) {
      display: block;
    }
  }
  /* The theme icon turns as it swaps, so the change reads as one control flipping state. */
  .theme-toggle :global(svg) {
    transition: transform var(--d-slow) var(--ease-out);
  }
  .theme-toggle[aria-pressed='true'] :global(svg) {
    transform: rotate(-30deg);
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--s-9);
    color: var(--muted);
    font-size: var(--t-md);
  }
  .site-footer-inner {
    max-width: var(--w-page);
    margin: 0 auto;
    padding: var(--s-6) var(--gutter) var(--s-7);
    display: grid;
    gap: var(--s-2);
  }
  .site-footer p {
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
  }
  .footer-links a {
    color: var(--ink-2);
    text-decoration-color: var(--line-strong);
  }
  .fineprint {
    font-size: var(--t-sm);
  }
  .menu-btn {
    display: none;
  }
  @media (max-width: 760px) {
    .site-header-inner {
      flex-wrap: wrap;
      gap: 0 var(--s-1);
      position: relative;
    }
    .wordmark-sub {
      display: none;
    }
    .header-actions {
      order: 2;
    }
    .search-btn {
      min-width: 0;
      width: var(--h-touch);
      padding: 0;
      justify-content: center;
      border-color: transparent;
      background: transparent;
      box-shadow: none;
      margin-right: 0;
    }
    .search-label,
    .search-kbd {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
      order: 3;
    }
    .menu-btn path {
      transform-box: fill-box;
      transform-origin: center;
      transition: transform var(--d-base) var(--ease-out), opacity var(--d-fast) ease;
    }
    .menu-btn[aria-expanded='true'] .m1 {
      transform: translateY(5px) rotate(45deg);
    }
    .menu-btn[aria-expanded='true'] .m2 {
      opacity: 0;
      transform: scaleX(0.4);
    }
    .menu-btn[aria-expanded='true'] .m3 {
      transform: translateY(-5px) rotate(-45deg);
    }
    /* The phone menu drops down from the header it belongs to (origin: top), and closes faster than it opens. */
    .site-nav {
      order: 4;
      width: 100%;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      opacity: 0;
      transition:
        grid-template-rows var(--d-exit) var(--ease-out),
        opacity var(--d-exit) ease,
        visibility 0s linear var(--d-exit);
    }
    .site-nav > ul {
      overflow: hidden;
      min-height: 0;
    }
    .menu-open .site-nav {
      grid-template-rows: 1fr;
      visibility: visible;
      opacity: 1;
      transition:
        grid-template-rows var(--d-slow) var(--ease-drawer),
        opacity var(--d-base) ease,
        visibility 0s;
    }
    .site-nav ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-2);
      padding: var(--s-2) 0 var(--s-3);
    }
    .site-nav a {
      display: grid;
      place-items: center;
      min-height: var(--h-lg);
      padding: var(--s-2);
      border: 1px solid var(--line);
      background: var(--surface);
      box-shadow: var(--shadow-1);
      font-size: var(--t-ui);
    }
    .site-nav a:active {
      transform: scale(var(--press-scale));
    }
    .site-nav a[aria-current='page'] {
      border-color: var(--accent);
      color: var(--accent);
    }
    .site-nav a[aria-current='page']::after {
      display: none;
    }
  }
</style>
