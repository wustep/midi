---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path of the active top-level section, e.g. "/docs" */
  section?: string;
}

const { title, description = 'The field guide to MIDI: protocol docs, interactive tools, and a curated catalog of open-source MIDI libraries.', section } = Astro.props;
const fullTitle = title === 'MIDI Field Guide' ? title : `${title} · MIDI Field Guide`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/docs/', label: 'Docs', key: '/docs' },
  { href: '/libraries/', label: 'Libraries', key: '/libraries' },
  { href: '/reader/', label: 'Reader', key: '/reader' },
  { href: '/tools/', label: 'Tools', key: '/tools' },
  { href: '/samples/', label: 'Samples', key: '/samples' },
  { href: '/community/', label: 'Community', key: '/community' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f2efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11110f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MIDI Field Guide" />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MIDI Field Guide: the bytes 90 3C 64 decoded as Note On, middle C, velocity 100." />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/" aria-label="MIDI Field Guide, home">
          <svg class="din" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <rect x="13.5" y="1" width="5" height="4" rx="1" fill="currentColor"></rect>
            <circle cx="7.5" cy="15" r="2" fill="currentColor"></circle>
            <circle cx="24.5" cy="15" r="2" fill="currentColor"></circle>
            <circle cx="10" cy="21.5" r="2" fill="currentColor"></circle>
            <circle cx="22" cy="21.5" r="2" fill="currentColor"></circle>
            <circle cx="16" cy="24" r="2" fill="var(--accent)"></circle>
          </svg>
          <span class="wordmark-text">MIDI<span class="wordmark-sub">Field Guide</span></span>
        </a>
        <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-actions">
          <a class="icon-btn" href="https://github.com/wustep/midi-new" aria-label="Source on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
          </a>
          <button class="icon-btn theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"
                ><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"
                ></path></g
              ></svg
            >
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path></svg
            >
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          <strong>MIDI Field Guide</strong> is an open, community-maintained reference. Code
          <a href="https://github.com/wustep/midi-new/blob/main/LICENSE">MIT</a>, content and data
          <a href="https://github.com/wustep/midi-new/blob/main/LICENSE-CC0">CC0</a>.
          <a href="https://github.com/wustep/midi-new/blob/main/CONTRIBUTING.md">Contribute on GitHub</a>.
        </p>
        <p class="fineprint">
          MIDI is a trademark of the MIDI Manufacturers Association. This site is independent and not affiliated with
          the MMA or AMEI. Always check the official specifications at
          <a href="https://midi.org/specs">midi.org/specs</a>.
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const sync = () => btn?.setAttribute('aria-pressed', String(current() === 'dark'));
      sync();

      // Phone menu: the primary nav collapses behind a button.
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const header = document.querySelector<HTMLElement>('.site-header');
      const setMenu = (open: boolean) => {
        menuBtn?.setAttribute('aria-expanded', String(open));
        header?.classList.toggle('menu-open', open);
      };
      menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header?.classList.contains('menu-open')) {
          setMenu(false);
          menuBtn?.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (header?.classList.contains('menu-open') && !header.contains(e.target as Node)) setMenu(false);
      });
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        sync();
      });

      // Wide tables and code blocks scroll sideways on small screens. Make the ones that
      // actually overflow keyboard-focusable, labelled by their caption or nearest heading.
      const usedLabels = new Map<string, number>();
      const labelFor = (el: HTMLElement) => {
        const kind = el.tagName === 'PRE' ? 'Code' : 'Table';
        let ctx = el.querySelector('caption')?.textContent?.trim();
        for (let n: Element | null = el; !ctx && n && n !== document.body; n = n.previousElementSibling ?? n.parentElement) {
          if (/^H[2-4]$/.test(n.tagName) && n !== el) ctx = n.textContent?.trim();
        }
        const base = ctx ? `${kind}: ${ctx}` : kind;
        const count = (usedLabels.get(base) ?? 0) + 1;
        usedLabels.set(base, count);
        return count > 1 ? `${base} (${count})` : base;
      };
      const update = (el: HTMLElement) => {
        const scrolls = el.scrollWidth > el.clientWidth || el.scrollHeight > el.clientHeight;
        const auto = 'autoFocusable' in el.dataset;
        if (scrolls && !auto && !el.hasAttribute('tabindex')) {
          el.dataset.autoFocusable = '';
          el.tabIndex = 0;
          el.setAttribute('role', 'region');
          el.setAttribute('aria-label', el.dataset.label ??= labelFor(el));
        } else if (!scrolls && auto) {
          delete el.dataset.autoFocusable;
          el.removeAttribute('tabindex');
          el.removeAttribute('role');
          el.removeAttribute('aria-label');
        }
      };
      const observer = new ResizeObserver((entries) => entries.forEach((e) => update(e.target as HTMLElement)));
      const boxes = [...document.querySelectorAll<HTMLElement>('.table-wrap, pre')].filter(
        // Leave boxes that already manage their own focus (e.g. the note table widget).
        (el) => !el.hasAttribute('tabindex') || 'autoFocusable' in el.dataset,
      );
      for (const el of boxes) observer.observe(el);
      // Web fonts change content width without resizing the box, so check again once they load.
      document.fonts?.ready.then(() => boxes.forEach(update));
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.6rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .din {
    width: 30px;
    height: 30px;
  }
  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .wordmark-sub {
    font-weight: 500;
    font-stretch: 100%;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .site-nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    gap: 0.25rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .i-moon {
    display: none;
  }
  :global([data-theme='dark']) .i-sun {
    display: none;
  }
  :global([data-theme='dark']) .i-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .i-moon {
      display: block;
    }
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .site-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem var(--gutter) 3rem;
  }
  .fineprint {
    font-size: 0.82rem;
  }
  .menu-btn {
    display: none;
  }
  @media (max-width: 760px) {
    .site-header-inner {
      flex-wrap: wrap;
      gap: 0 0.5rem;
      position: relative;
    }
    .wordmark-sub {
      display: none;
    }
    .header-actions {
      order: 2;
    }
    .menu-btn {
      display: inline-grid;
      order: 3;
      border-color: var(--line);
    }
    .site-nav {
      display: none;
      order: 4;
      width: 100%;
      padding: 0.5rem 0 0.75rem;
    }
    .menu-open .site-nav {
      display: block;
    }
    .site-nav ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
    }
    .site-nav a {
      display: grid;
      place-items: center;
      min-height: 2.9rem;
      padding: 0.4rem;
      border: 1px solid var(--line);
      background: var(--surface);
      font-size: 0.95rem;
    }
    .site-nav a[aria-current='page'] {
      border-color: var(--accent);
      box-shadow: inset 0 -2px 0 var(--accent);
    }
  }
</style>
