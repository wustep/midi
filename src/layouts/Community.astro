---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Which sub-page is active. */
  page: 'community' | 'midi-files';
}
const { title, description, page } = Astro.props;
---

<Base title={title} section="/community" description={description}>
  <div class="page community-page">
    <slot />
  </div>
</Base>

<style>
  .community-page :global(.toc) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: var(--s-4) 0 var(--s-2);
  }
  .community-page :global(.toc a) {
    font-size: var(--t-md);
  }
</style>
