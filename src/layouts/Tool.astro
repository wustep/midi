---
import Base from './Base.astro';
import { tools, toolBySlug } from '../lib/tools';
import { libsForTool } from '../lib/related';
import Shortcuts from '../components/Shortcuts.astro';

interface Props {
  slug: string;
  description?: string;
  /** Let the tool use the full page width (big grids and tables). */
  wide?: boolean;
  /** Keyboard shortcuts shown under the tool. */
  shortcuts?: [string, string][];
}
const { slug, description, wide = false, shortcuts = [] } = Astro.props;
const tool = toolBySlug(slug);
const siblings = tools.filter((t) => t.group === tool.group && t.slug !== slug);
const libs = libsForTool(slug);
---

<Base title={tool.title} section="/tools" description={description ?? tool.blurb}>
  <div class="page tool-page">
    <header class="page-head">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          <li><a href="/tools/">Tools</a></li>
          <li>{tool.group}</li>
        </ol>
      </nav>
      <h1>{tool.title}</h1>
      <p class="lede"><slot name="lede">{tool.blurb}</slot></p>
      {
        (tool.docs.length > 0 || libs.length > 0) && (
          <div class="related">
            {tool.docs.length > 0 && (
              <div>
                <strong>Background</strong>
                {tool.docs.map((d) => <a href={d.href}>{d.label}</a>)}
              </div>
            )}
            {libs.length > 0 && (
              <div>
                <strong>Libraries</strong>
                {libs.map((l) => <a href={l.href}>{l.label}</a>)}
              </div>
            )}
          </div>
        )
      }
    </header>
    <div class:list={['tool-body', { wide }]}>
      <slot />
      {shortcuts.length > 0 && <Shortcuts items={shortcuts} />}
      <slot name="after" />
    </div>
    <nav class="more-tools" aria-labelledby="more-tools-title">
      <h2 id="more-tools-title" class="section-title">More to {tool.group.toLowerCase()}</h2>
      <ul class="card-grid">
        {
          siblings.map((t) => (
            <li>
              <a class="card" href={t.href}>
                <span class="card-title">{t.title}</span>
                <span class="card-text">{t.blurb}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="card all" href="/tools/">
            <span class="card-title">All {tools.length} tools →</span>
            <span class="card-text">Inspect, build and send, look up, calculate.</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</Base>

<style>
  .tool-body {
    max-width: var(--w-tool);
  }
  .tool-body.wide {
    max-width: none;
  }
  /* The page H1 already names the tool, so the widget's own heading is only for screen readers. */
  .tool-body > :global(.widget:only-of-type > .widget-head) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .tool-body :global(.note-small) {
    font-size: var(--t-md);
    color: var(--ink-2);
    max-width: var(--w-read);
  }
  .more-tools {
    margin-top: var(--s-8);
    padding-top: var(--s-2);
    border-top: 1px solid var(--line);
    --card-min: 220px;
  }
  .more-tools .section-title {
    margin-top: var(--s-5);
  }
  .more-tools .all {
    background: transparent;
    box-shadow: none;
  }
  @media (max-width: 560px) {
    /* Titles only on phones; the hub has the descriptions. */
    .more-tools .card-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-2);
    }
    .more-tools .card {
      padding: var(--s-3);
    }
    .more-tools .card-text {
      display: none;
    }
  }
</style>
