---
/**
 * The design system, live: every token and primitive rendered from the same CSS the site uses
 * (src/styles/tokens.css and global.css). Written up in docs/DESIGN.md.
 */
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import Icon from '../components/Icon.astro';
import { ICONS, iconSvg } from '../lib/icons.mjs';
import { THEMES, DEFAULT_THEME } from '../themes/registry.ts';
import { themeSummary } from '../themes/css.ts';

const themes = THEMES.map(themeSummary);
const pad = (n: number) => String(n).padStart(2, '0');

const surfaces = [
  ['--surface-sunken', 'Sunken', 'Inputs, code, readouts'],
  ['--bg', 'Page', 'The paper everything sits on'],
  ['--surface', 'Raised', 'Cards, panels, tables'],
  ['--surface-raised', 'Floating', 'Dialogs, selected segments'],
  ['--surface-2', 'Fill', 'Hover fills, quiet badges'],
];
const inks = [
  ['--ink', 'Ink', 'Headings and body'],
  ['--ink-2', 'Ink 2', 'Secondary text'],
  ['--muted', 'Muted', 'Meta, hints (4.5:1 on paper)'],
  ['--control', 'Control', 'Field borders (3:1)'],
  ['--line-strong', 'Line strong', 'Raised edges'],
  ['--line', 'Line', 'Hairlines and dividers'],
];
const roles = [
  ['--accent', '--accent-soft', 'Status', 'Status bytes, links, the active section', '90'],
  ['--data', '--data-soft', 'Data', 'Data bytes, success', '3C'],
  ['--meta', '--meta-soft', 'Meta', 'Meta events, SysEx', 'FF'],
  ['--warn', '--warn-soft', 'Warn', 'Cautions, unverified', '!'],
];
const extras = [
  ['--focus', 'Focus', 'Keyboard focus only'],
  ['--sky', 'Sky', 'Chart series'],
  ['--olive', 'Olive', 'Chart series'],
];
const sizes = [
  ['--t-display', 'Display', 'Home hero only', 'The field guide'],
  ['--t-3xl', '3XL', 'Page titles (h1)', 'Message decoder'],
  ['--t-2xl', '2XL', 'Section titles (h2)', 'Running status'],
  ['--t-xl', 'XL', 'Large numbers', 'Pitch bend ±2 semitones'],
  ['--t-lg', 'LG', 'Lede, h3', 'A Note On is three bytes.'],
  ['--t-base', 'Base', 'Body text', 'Status bytes have the top bit set; data bytes never do.'],
  ['--t-ui', 'UI', 'Buttons, nav, inputs', 'Open a MIDI file'],
  ['--t-md', 'MD', 'Card text, tables', 'Header and track chunks, delta times, meta events.'],
  ['--t-sm', 'SM', 'Hints, dense UI', 'Paste or type bytes, e.g. B0 07 64'],
  ['--t-xs', 'XS', 'Captions, badges, labels', 'COMMERCIAL USE OK'],
  ['--t-2xs', '2XS', 'Axis and key labels', 'C4  C#4  D4'],
];
const space = ['--s-0', '--s-1', '--s-2', '--s-3', '--s-4', '--s-5', '--s-6', '--s-7', '--s-8', '--s-9'];
const radii = [
  ['--r-2xs', 'Keys, tiny marks'],
  ['--r-xs', 'Byte chips, badges, kbd'],
  ['--r-sm', 'Buttons, inputs, segments'],
  ['--r-md', 'Cards, tables, code'],
  ['--r-lg', 'Panels, dialogs'],
  ['--r-pill', 'Chips, search'],
];
const elevations = [
  ['sunken', 'Sunken', '--shadow-inset', 'A well you type or read into.'],
  ['page', 'Page', 'none', 'Flat paper.'],
  ['raised', 'Raised', '--shadow-1', 'Resting cards and buttons.'],
  ['panel', 'Panel', '--shadow-2', 'Tools; cards on hover.'],
  ['floating', 'Floating', '--shadow-3', 'Search palette, dialogs.'],
];
const curves = [
  ['--ease-out', 'Ease out', '0.23, 1, 0.32, 1', 'Anything entering or responding to input.'],
  ['--ease-in-out', 'Ease in-out', '0.77, 0, 0.175, 1', 'Something already on screen moving to a new place.'],
  ['--ease-drawer', 'Drawer', '0.32, 0.72, 0, 1', 'Menus and sheets sliding open.'],
];
const durations = [
  ['--d-press', '100ms', 'Press feedback (scale 0.97)'],
  ['--d-exit', '120ms', 'Exits: faster than entrances'],
  ['--d-fast', '140ms', 'Hover and color changes'],
  ['--d-base', '200ms', 'Popovers, toggles, chevrons'],
  ['--d-slow', '280ms', 'Dialogs, menus, theme change'],
];
const curvePath = (v: string) => {
  const [x1, y1, x2, y2] = v.split(',').map(Number);
  return `M0 100 C${x1 * 100} ${100 - y1 * 100} ${x2 * 100} ${100 - y2 * 100} 100 0`;
};
---

<Base title="Design system" description="The MIDI Field Guide's design tokens and components: color, type, spacing, radii, elevation, motion and focus, rendered live.">
  <div class="page ds">
    <header class="page-head">
      <p class="eyebrow">Design system</p>
      <h1>One system, {themes.length === 1 ? 'one theme' : `${themes.length} themes`}</h1>
      <p class="lede">
        Every color, size and curve on this site comes from one set of tokens, and a theme is only a different set of
        values for them. This page renders the tokens with the same CSS the site uses, so it is always current.
        {themes.length > 1 ? 'Change the theme from the knob in the header and watch it follow.' : 'Switch light and dark in the header to see both.'}
      </p>
    </header>

    <nav class="ds-toc" aria-label="On this page">
      {['Principles', 'Themes', 'Color', 'Type', 'Space', 'Radii', 'Elevation', 'Motion', 'Focus', 'MIDI marks', 'Icons', 'Components'].map((s) => <a href={`#${s.toLowerCase().replace(' ', '-')}`}>{s}</a>)}
    </nav>

    <section aria-labelledby="principles">
      <h2 id="principles">Principles</h2>
      <ol class="principles">
        <li><strong>Color means a byte role.</strong> In every theme, one hue is a status byte, one is data, one is meta. Decoration never borrows them.</li>
        <li><strong>Hardware, sparingly.</strong> LEDs for what's on, keycaps that travel, a beat ruler at big breaks, a step grid behind the hero. Cues, never costume.</li>
        <li><strong>Quiet until touched.</strong> Links and controls rest calm, answer on hover with a fine pointer, and always answer on press.</li>
        <li><strong>Fast, honest motion.</strong> Under 300 ms, custom ease-out curves, nothing on keyboard shortcuts, no movement with reduced motion.</li>
      </ol>
    </section>

    <section aria-labelledby="themes">
      <h2 id="themes">Themes</h2>
      <p class="ds-note">
        Each theme is a plain data file in <code>src/themes/</code>: colors for light, dark or both, three or four fonts, and a few
        type and shape settings. <code>src/themes/registry.ts</code> lists them; the first, {DEFAULT_THEME.name}, is the default.
        Every theme and mode is tested for WCAG AA contrast (<code>tests/themes.test.ts</code>).
      </p>
      <ul class="themes">
        {
          themes.map((t, i) => (
            <li class="theme">
              <div class="th-specimens">
                {t.modes.map((m) => {
                  const w = t.swatch[m]!;
                  return (
                    <div class="th-spec" style={`background:${w.bg};color:${w.ink};border-color:${w.line}`} aria-hidden="true">
                      <span class="th-aa" style={`font-family:${t.displayFont.replace(/'/g, '"')}`}>Aa</span>
                      <span class="th-bytes" style={`font-family:${t.monoFont.replace(/'/g, '"')}`}>
                        <span style={`color:${w.accent};background:${w.accentSoft}`}>90</span>
                        <span style={`color:${w.data};background:${w.dataSoft}`}>3C</span>
                        <span style={`color:${w.meta};background:${w.metaSoft}`}>FF</span>
                      </span>
                      <span class="th-btn" style={`background:${w.primary};color:${w.onPrimary};font-family:${t.textFont.replace(/'/g, '"')}`}>Play</span>
                      <span class="th-led" style={`background:${w.led};box-shadow:0 0 6px ${w.led}`} />
                      <span class="th-mode" style={`color:${w.muted}`}>{m}</span>
                    </div>
                  );
                })}
              </div>
              <div class="th-body">
                <p class="th-name">
                  <span class="th-n">{pad(i + 1)}</span> {t.name}
                </p>
                <p class="th-dir">{t.direction}</p>
                <p class="th-fonts">{t.fontNames.join(' · ')}</p>
                {themes.length > 1 && (
                  <button type="button" class="btn btn-sm" data-use-theme={t.id}>
                    Use {t.name}
                  </button>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="color">
      <h2 id="color">Color</h2>
      <p class="ds-note">The semantic color tokens, as the current theme sets them. Components only use these names; a theme or a mode swaps the values.</p>

      <h3>Byte roles</h3>
      <ul class="roles">
        {
          roles.map(([fg, bg, name, use, sample]) => (
            <li class="role">
              <span class="role-chip" style={`color: var(${fg}); background: var(${bg})`}>{sample}</span>
              <div>
                <p class="sw-name">{name}</p>
                <p class="sw-use">{use}</p>
                <p class="sw-token"><code>{fg}</code> <span data-value={fg} /></p>
                <p class="sw-token"><code>{bg}</code> <span data-value={bg} /></p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3>Surfaces</h3>
      <ul class="swatches">
        {
          surfaces.map(([t, name, use]) => (
            <li>
              <span class="sw" style={`background: var(${t})`} />
              <p class="sw-name">{name}</p>
              <p class="sw-use">{use}</p>
              <p class="sw-token"><code>{t}</code> <span data-value={t} /></p>
            </li>
          ))
        }
      </ul>

      <h3>Ink and lines</h3>
      <ul class="swatches">
        {
          [...inks, ...extras].map(([t, name, use]) => (
            <li>
              <span class="sw" style={`background: var(${t})`} />
              <p class="sw-name">{name}</p>
              <p class="sw-use">{use}</p>
              <p class="sw-token"><code>{t}</code> <span data-value={t} /></p>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="type">
      <h2 id="type">Type</h2>
      <p class="ds-note">
        <strong>Archivo</strong> (expanded widths) for display, <strong>Atkinson Hyperlegible Next</strong> for text, and
        <strong>Atkinson Hyperlegible Mono</strong> for bytes, all variable. Sizes are in rem so they follow the reader's
        text size. Tracking tightens as type grows (<code>--tr-display</code> −0.03em) and opens on uppercase labels
        (<code>--tr-label</code> 0.08em); leading tightens from 1.6 on body to 1.0 on display.
      </p>
      <ul class="type-scale">
        {
          sizes.map(([t, name, use, sample], i) => (
            <li>
              <div class="ts-meta">
                <code>{t}</code>
                <span class="sw-use">{use}</span>
                <span class="sw-token" data-value={t} data-px />
              </div>
              <p class:list={['ts-sample', i < 3 && 'ts-display', i === 9 && 'ts-label']} style={`font-size: var(${t})`}>
                {sample}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="mono-sample"><span class="b b-s">90</span> <span class="b b-d">3C</span> <span class="b b-d">64</span> Bytes are mono, bold, tabular, with a 0 that can't be mistaken for O.</p>
    </section>

    <section aria-labelledby="space">
      <h2 id="space">Space</h2>
      <p class="ds-note">A 4px base. Layouts snap to these steps; one-off values are a bug.</p>
      <ul class="space">
        {
          space.map((t) => (
            <li>
              <code>{t}</code>
              <span class="bar" style={`width: var(${t})`} />
              <span class="sw-token" data-value={t} data-px />
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="radii">
      <h2 id="radii">Radii</h2>
      <p class="ds-note">Nested corners step down one size per level, so inner and outer curves stay concentric.</p>
      <ul class="radii">
        {
          radii.map(([t, use]) => (
            <li>
              <span class="rbox" style={`border-radius: var(${t})`} />
              <code>{t}</code>
              <span class="sw-use">{use}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="elevation">
      <h2 id="elevation">Elevation</h2>
      <p class="ds-note">Five levels. Shadows are short, warm and lit from above, with a highlight on the top edge; dark mode deepens them.</p>
      <ul class="elev">
        {
          elevations.map(([k, name, t, use]) => (
            <li>
              <span class={`ebox e-${k}`} />
              <p class="sw-name">{name}</p>
              <p class="sw-use">{use}</p>
              <code>{t}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="motion">
      <h2 id="motion">Motion</h2>
      <p class="ds-note">
        Custom curves, because the CSS keywords are too weak, and never <code>ease-in</code> for UI. Press the buttons:
        each dot uses its curve at <code>--d-slow</code>, and you can reverse it mid-flight because these are transitions,
        not keyframes.
      </p>
      <ul class="curves">
        {
          curves.map(([t, name, v, use]) => (
            <li>
              <svg viewBox="-6 -6 112 112" aria-hidden="true" class="curve">
                <path d="M0 100 L100 0" class="curve-diag" />
                <path d={curvePath(v)} class="curve-line" />
              </svg>
              <div>
                <p class="sw-name">{name}</p>
                <p class="sw-use">{use}</p>
                <p class="sw-token"><code>{t}</code> cubic-bezier({v})</p>
                <div class="track" style={`--curve: var(${t})`}>
                  <span class="dot" />
                </div>
                <button type="button" class="btn btn-sm" data-play aria-pressed="false">Play</button>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Token</th><th>Value</th><th>Use</th></tr></thead>
          <tbody>
            {durations.map(([t, v, use]) => <tr><td><code>{t}</code></td><td>{v}</td><td>{use}</td></tr>)}
          </tbody>
        </table>
      </div>
      <Callout title="Rules of thumb">
        <ul>
          <li>Don't animate what people trigger from the keyboard dozens of times (the search palette opens instantly on ⌘K).</li>
          <li>Hover effects only on devices with a fine pointer: <code>@media (hover: hover) and (pointer: fine)</code>.</li>
          <li>Things leave the way they came, and faster than they arrived: the same <code>--ease-out</code> at <code>--d-exit</code>.</li>
          <li>With reduced motion, movement goes and color and opacity changes stay.</li>
        </ul>
      </Callout>
    </section>

    <section aria-labelledby="focus">
      <h2 id="focus">Focus</h2>
      <p class="ds-note">
        One ring for everything: <code>--focus-width</code> (2px, 3px with increased contrast) of <code>--focus</code>,
        offset <code>--focus-offset</code> from the edge, following the element's own radius. Text fields swap their
        border for the focus color and add a soft halo. Press <kbd>Tab</kbd> through the components below.
      </p>
    </section>

    <section aria-labelledby="midi-marks">
      <h2 id="midi-marks">MIDI marks</h2>
      <p class="ds-note">
        A few hardware cues, kept small. Each theme recolors them, and none carries meaning on its own: an LED always
        sits next to a label or a state that says the same thing.
      </p>
      <div class="marks">
        <div class="mark">
          <div class="mark-demo"><span class="led" /> <span class="led on" /> <span class="led" data-on /></div>
          <p class="sw-name">LED</p>
          <p class="sw-use"><code>.led</code>, lit with <code>.on</code>. The MIDI IN light, the current section, the chosen theme. Color <code>--led</code>, bleed <code>--led-blur</code>.</p>
        </div>
        <div class="mark">
          <div class="mark-demo"><button type="button" class="btn">Keycap</button> <button type="button" class="btn btn-primary">Primary</button></div>
          <p class="sw-name">Keycaps</p>
          <p class="sw-use">Buttons have a lit top edge and a heavier lip; pressed, they travel down 1px and lose the lip.</p>
        </div>
        <div class="mark mark-wide">
          <div class="mark-demo"><div class="rule-beats" style="width: 100%" /></div>
          <p class="sw-name">Beat ruler</p>
          <p class="sw-use"><code>.rule-beats</code>: a timeline's ticks for the big breaks between sections. Themes redraw it: step lights, staves, a heavy rule.</p>
        </div>
        <div class="mark mark-wide">
          <div class="mark-demo mark-texture textured" />
          <p class="sw-name">Texture</p>
          <p class="sw-use"><code>.textured</code> draws the theme's <code>--texture</code> (a step grid, a piano roll, staves, dots) behind the hero, faded out from a focal point.</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="icons">
      <h2 id="icons">Icons</h2>
      <p class="ds-note">
        One set, drawn for this site in <code>src/lib/icons.mjs</code>: a 24px grid with a 2px safe area, one 2px
        stroke with round caps and joins, 2px corner radii, and solid fills only for the media glyphs and the star.
        Use <code>&lt;Icon name="…" /&gt;</code> in markup or <code>iconSvg()</code> in scripts; the favicons and
        social cards are generated from the same brand mark.
      </p>
      <ul class="icon-grid">
        {
          Object.keys(ICONS).map((name) => (
            <li>
              <span class="icon-big" set:html={iconSvg(name, { size: 32 })} />
              <span class="icon-small">
                <Fragment set:html={iconSvg(name, { size: 20 })} />
                <Fragment set:html={iconSvg(name, { size: 16 })} />
              </span>
              <code>{name}</code>
            </li>
          ))
        }
      </ul>
      <div class="icon-spec">
        <svg viewBox="0 0 24 24" width="192" height="192" aria-hidden="true">
          <defs>
            <pattern id="grid1" width="1" height="1" patternUnits="userSpaceOnUse"><path d="M1 0H0V1" fill="none" stroke="var(--line)" stroke-width="0.04" /></pattern>
          </defs>
          <rect width="24" height="24" fill="url(#grid1)" />
          <rect x="2" y="2" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="0.08" stroke-dasharray="0.4 0.3" />
          <circle cx="12" cy="12" r="9" fill="none" stroke="var(--data)" stroke-width="0.08" />
          <rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="var(--data)" stroke-width="0.08" />
          <rect x="5" y="3" width="14" height="18" rx="2" fill="none" stroke="var(--meta)" stroke-width="0.08" />
          <g fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" set:html={ICONS.din.body.replace(/var\(--pin, currentColor\)/g, 'var(--accent)').replace(/currentColor/g, 'var(--ink)')} />
        </svg>
        <ul class="spec-list">
          <li><span class="key k-safe"></span> 2px safe area: nothing crosses it</li>
          <li><span class="key k-circle"></span> Keylines: circle r 9, square 16, upright 14 × 18</li>
          <li><span class="key k-tall"></span> Tall shapes (file, pause) use the upright keyline</li>
          <li>Stroke 2 at 24px; scaled with the icon, so it is 1.33px at 16px</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="components">
      <h2 id="components">Components</h2>

      <div class="demo">
        <h3>Buttons</h3>
        <p class="ds-note">Heights <code>--h-sm</code> 32, <code>--h-md</code> 40, <code>--h-lg</code> 48; 44px minimum on touch screens. One primary per view.</p>
        <div class="row">
          <button type="button" class="btn btn-primary">Read the docs</button>
          <button type="button" class="btn">Open a MIDI file</button>
          <button type="button" class="btn btn-ghost">Clear</button>
          <button type="button" class="btn" disabled>Disabled</button>
        </div>
        <div class="row">
          <button type="button" class="btn btn-sm">Small</button>
          <button type="button" class="btn">Medium</button>
          <button type="button" class="btn btn-lg">Large</button>
          <button type="button" class="icon-btn" aria-label="Icon button">
            <Icon name="search" size={20} />
          </button>
        </div>
      </div>

      <div class="demo">
        <h3>Chips and segmented controls</h3>
        <p class="ds-note">Chips filter (any number on). A segmented control picks one of a few.</p>
        <div class="row" data-chips>
          <button type="button" class="chip" aria-pressed="true">All <span class="n">98</span></button>
          <button type="button" class="chip" aria-pressed="false">Beginner-friendly <span class="n">21</span></button>
          <button type="button" class="chip" aria-pressed="false">Developers <span class="n">34</span></button>
        </div>
        <div class="row">
          <div class="seg" role="group" aria-label="Number format" data-seg>
            <button type="button" aria-pressed="true">Hex</button>
            <button type="button" aria-pressed="false">Decimal</button>
            <button type="button" aria-pressed="false">Binary</button>
          </div>
        </div>
      </div>

      <div class="demo">
        <h3>Fields</h3>
        <p class="ds-note">Inputs are sunken wells, so they never read as cards.</p>
        <div class="fields">
          <label>
            <span class="field-label">Hex bytes</span>
            <input type="text" value="90 3C 64" spellcheck="false" />
          </label>
          <label>
            <span class="field-label">Channel</span>
            <select><option>1</option><option>10 (drums)</option></select>
          </label>
          <label>
            <span class="field-label">Velocity</span>
            <input type="number" value="100" min="1" max="127" />
          </label>
          <label>
            <span class="field-label">Search</span>
            <input type="search" placeholder="rust, soundfont, mpe…" />
          </label>
        </div>
        <div class="row">
          <label class="check"><input type="checkbox" checked /> Running status</label>
          <label class="check"><input type="checkbox" /> Show real-time bytes</label>
          <label class="check range"><span>Pitch bend</span> <input type="range" min="-8192" max="8191" value="0" /></label>
        </div>
      </div>

      <div class="demo">
        <h3>Marks</h3>
        <div class="row">
          <span class="b b-s">B0</span><span class="b b-d">07</span><span class="b b-d">64</span><span class="b b-m">F0</span>
          <span class="badge good">Commercial use OK</span>
          <span class="badge warn">Commercial use unclear</span>
          <span class="badge bad">Non-commercial</span>
          <span class="badge meta">Share-alike</span>
          <span class="badge">Archived</span>
          <span><kbd>⌘</kbd> <kbd>K</kbd></span>
        </div>
      </div>

      <div class="demo">
        <h3>Callouts</h3>
        <Callout><p>A Note On with velocity 0 is a Note Off.</p></Callout>
        <Callout type="warn"><p>Free to use is not free to share.</p></Callout>
        <Callout type="note"><p>Running status lets a sender skip a status byte that repeats.</p></Callout>
      </div>

      <div class="demo">
        <h3>Cards and tables</h3>
        <ul class="card-grid">
          <li>
            <a class="card" href="/docs/messages/">
              <span class="card-kicker">Docs</span>
              <span class="card-title">Messages</span>
              <span class="card-text">Status and data bytes, channel voice and mode messages, running status.</span>
            </a>
          </li>
          <li>
            <a class="card" href="/tools/decoder/">
