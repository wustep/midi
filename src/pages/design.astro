<script>
  // Show each token's resolved value, and refresh when the theme changes.
  const root = document.documentElement;
  const fmt = (el: HTMLElement) => {
    const name = el.dataset.value!;
    let v = getComputedStyle(root).getPropertyValue(name).trim();
    if ('px' in el.dataset) {
      // Resolve rem/clamp to pixels with a probe element.
      const probe = document.createElement('div');
      probe.style.cssText = `position:absolute;visibility:hidden;width:var(${name})`;
      document.body.append(probe);
      v = `${Math.round(probe.getBoundingClientRect().width * 10) / 10}px`;
      probe.remove();
    } else if (v.startsWith('var(')) {
      v = getComputedStyle(root).getPropertyValue(v.slice(4, -1)).trim();
    }
    el.textContent = v;
  };
  const refresh = () => document.querySelectorAll<HTMLElement>('[data-value]').forEach(fmt);
  refresh();
  new MutationObserver(refresh).observe(root, { attributes: true, attributeFilter: ['data-theme', 'data-mode'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', refresh);
  addEventListener('resize', refresh);

  // "Use" buttons drive the header picker, so the choice persists and everything stays in sync.
  document.querySelectorAll<HTMLButtonElement>('[data-use-theme]').forEach((b) =>
    b.addEventListener('click', () => document.querySelector<HTMLButtonElement>(`.tp-opt[data-id="${b.dataset.useTheme}"]`)?.click()),
  );

  // Motion demos: toggling a class runs (or reverses) a transition.
  document.querySelectorAll<HTMLButtonElement>('[data-play]').forEach((b) =>
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      b.textContent = on ? 'Reverse' : 'Play';
      b.previousElementSibling?.classList.toggle('on', on);
    }),
  );
  // Demo chips and segmented control.
  document.querySelectorAll<HTMLElement>('[data-chips] .chip').forEach((c) =>
    c.addEventListener('click', () => c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'))),
  );
  document.querySelectorAll<HTMLElement>('[data-seg]').forEach((g) =>
    g.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
    }),
  );
</script>

