      {
        lang: 'rs', lib: 'midly', libQuery: 'midly',
        note: 'Tempo is tracked per track here, which is exact for format 0 files. For format 1, build the tempo map from track 0 first.',
        code: String.raw`use midly::{MetaMessage, MidiMessage, Smf, Timing, TrackEventKind};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let bytes = std::fs::read("song.mid")?;
    let smf = Smf::parse(&bytes)?;
    let ppq = match smf.header.timing {
        Timing::Metrical(t) => t.as_int() as f64,
        Timing::Timecode(..) => return Err("SMPTE timing not handled here".into()),
    };
    for (i, track) in smf.tracks.iter().enumerate() {
        let (mut secs, mut us_per_quarter) = (0.0, 500_000.0);
        for ev in track {
            secs += ev.delta.as_int() as f64 * us_per_quarter / ppq / 1e6;
            match ev.kind {
                TrackEventKind::Meta(MetaMessage::Tempo(t)) => us_per_quarter = t.as_int() as f64,
                TrackEventKind::Midi { channel, message: MidiMessage::NoteOn { key, vel } }
                    if vel.as_int() > 0 =>
                {
                    println!("track {i} {secs:8.3}s ch{} note {} vel {}",
                        channel.as_int() + 1, key.as_int(), vel.as_int());
                }
                _ => {}
            }
        }
    }
    Ok(())
}`,
