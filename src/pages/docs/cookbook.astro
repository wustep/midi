      {
        lang: 'rs', lib: 'midir', libQuery: 'midir',
        code: String.raw`use midir::{Ignore, MidiInput, MidiOutput};
use std::{sync::mpsc, time::Duration};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut input = MidiInput::new("ident")?;
    input.ignore(Ignore::None); // don't drop SysEx
    let in_ports = input.ports();
    let (tx, rx) = mpsc::channel();
    let _in = input.connect(in_ports.first().ok_or("no inputs")?, "ident-in",
        move |_, msg, _| { let _ = tx.send(msg.to_vec()); }, ())?;

    let output = MidiOutput::new("ident")?;
    let out_ports = output.ports();
    let mut out = output.connect(out_ports.first().ok_or("no outputs")?, "ident-out")?;
    out.send(&[0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7])?;

    while let Ok(msg) = rx.recv_timeout(Duration::from_secs(2)) {
        if msg.len() > 5 && msg[0] == 0xF0 && msg[1] == 0x7E && msg[3] == 0x06 && msg[4] == 0x02 {
            println!("Identity Reply: {:02X?}", msg);
            break;
        }
    }
    Ok(())
}`,
