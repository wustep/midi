const { writeMidi } = require('midi-file');
const { writeFileSync } = require('node:fs');

const track = [{ deltaTime: 0, meta: true, type: 'setTempo', microsecondsPerBeat: 500000 }];
for (const n of [60, 62, 64, 65, 67, 69, 71, 72]) {
  track.push({ deltaTime: 0, channel: 0, type: 'noteOn', noteNumber: n, velocity: 90 });
  track.push({ deltaTime: 480, channel: 0, type: 'noteOff', noteNumber: n, velocity: 0 });
}
track.push({ deltaTime: 0, meta: true, type: 'endOfTrack' });

const bytes = writeMidi({ header: { format: 0, numTracks: 1, ticksPerBeat: 480 }, tracks: [track] });
writeFileSync('c-major.mid', Buffer.from(bytes));`,
