    id: 'monitor',
    title: 'Monitor incoming messages',
    intro: 'Print every incoming message as hex. The Web MIDI API and midir hand you one complete message per callback; you never have to reassemble running status yourself.',
    docs: [{ label: 'Messages', href: '/docs/messages/' }, { label: 'Live monitor', href: '/try/' }],
    snippets: [
