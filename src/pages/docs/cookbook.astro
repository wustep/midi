        lang: 'py', lib: 'mido', libQuery: 'mido',
        code: String.raw`import time
import mido

inp = mido.open_input(mido.get_input_names()[0])
out = mido.open_output(mido.get_output_names()[0])

out.send(mido.Message('sysex', data=[0x7E, 0x7F, 0x06, 0x01]))  # mido adds F0/F7

deadline = time.time() + 2
while time.time() < deadline:
    for msg in inp.iter_pending():
        if msg.type == 'sysex' and msg.data[0] == 0x7E and list(msg.data[2:4]) == [0x06, 0x02]:
            print('Identity Reply:', msg.hex())
            deadline = 0
    time.sleep(0.01)`,
