    id: 'bend-range',
    title: 'Set pitch-bend range with RPN 0',
    intro: 'Select RPN 0,0 (Pitch Bend Sensitivity) with CC 101/100, write semitones to Data Entry MSB (CC 6) and cents to the LSB (CC 38), then send the null RPN (127,127) so a stray CC 6 later cannot change it.',
    docs: [{ label: 'RPN & NRPN', href: '/docs/rpn-nrpn/' }, { label: 'MPE', href: '/docs/mpe/' }],
    snippets: [
      {
        lang: 'js', lib: 'Web MIDI', libQuery: 'web midi',
        code: String.raw`function setBendRange(out, ch, semitones, cents = 0) {
  const cc = (num, value) => out.send([0xB0 | ch, num, value]);
  cc(101, 0); cc(100, 0);           // select RPN 0,0: Pitch Bend Sensitivity
  cc(6, semitones); cc(38, cents);  // Data Entry MSB = semitones, LSB = cents
  cc(101, 127); cc(100, 127);       // null RPN: deselect
}

const access = await navigator.requestMIDIAccess();
setBendRange([...access.outputs.values()][0], 0, 12); // ±12 semitones on channel 1`,
      },
      {
        lang: 'py', lib: 'mido', libQuery: 'mido',
        code: String.raw`import mido

def set_bend_range(out, channel, semitones, cents=0):
    for control, value in [(101, 0), (100, 0),          # select RPN 0,0
                           (6, semitones), (38, cents),  # Data Entry MSB / LSB
                           (101, 127), (100, 127)]:      # null RPN
        out.send(mido.Message('control_change', channel=channel,
                              control=control, value=value))

with mido.open_output(mido.get_output_names()[0]) as out:
    set_bend_range(out, 0, 12)`,
      },
      {
        lang: 'cpp', lib: 'RtMidi', libQuery: 'rtmidi',
        code: String.raw`#include <vector>
#include "RtMidi.h"

void setBendRange(RtMidiOut& out, unsigned char ch, unsigned char semitones,
                  unsigned char cents = 0) {
  const unsigned char pairs[6][2] = {{101, 0}, {100, 0},          // select RPN 0,0
                                     {6, semitones}, {38, cents}, // Data Entry
                                     {101, 127}, {100, 127}};     // null RPN
  for (auto& p : pairs) {
    std::vector<unsigned char> m{(unsigned char)(0xB0 | ch), p[0], p[1]};
    out.sendMessage(&m);
  }
}

int main() {
  RtMidiOut out;
  if (out.getPortCount() == 0) return 1;
  out.openPort(0);
  setBendRange(out, 0, 12);
}`,
      },
      {
        lang: 'rs', lib: 'midir', libQuery: 'midir',
        code: String.raw`use midir::{MidiOutput, MidiOutputConnection, SendError};

fn set_bend_range(conn: &mut MidiOutputConnection, ch: u8, semitones: u8, cents: u8)
    -> Result<(), SendError> {
    for (cc, value) in [(101, 0), (100, 0), (6, semitones), (38, cents), (101, 127), (100, 127)] {
        conn.send(&[0xB0 | ch, cc, value])?;
    }
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let out = MidiOutput::new("rpn")?;
    let ports = out.ports();
    let mut conn = out.connect(ports.first().ok_or("no output ports")?, "rpn-out")?;
    set_bend_range(&mut conn, 0, 12, 0)?;
    Ok(())
}`,
