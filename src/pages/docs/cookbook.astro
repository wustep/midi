        lang: 'cpp', lib: 'RtMidi', libQuery: 'rtmidi',
        code: String.raw`#include <cstdio>
#include <iostream>
#include <vector>
#include "RtMidi.h"

void onMessage(double deltaSeconds, std::vector<unsigned char>* msg, void*) {
  std::printf("%8.4f  ", deltaSeconds);
  for (unsigned char b : *msg) std::printf("%02X ", b);
  std::printf("\n");
}

int main() {
  RtMidiIn in;
  if (in.getPortCount() == 0) return 1;
  in.openPort(0);
  in.setCallback(&onMessage);
  in.ignoreTypes(false, true, true);  // keep SysEx; drop clock and active sensing
  std::cout << "Listening on " << in.getPortName(0) << ". Press Enter to quit.\n";
  std::cin.get();
}`,
      },
      {
        lang: 'rs', lib: 'midir', libQuery: 'midir',
        code: String.raw`use midir::{Ignore, MidiInput};
use std::io::stdin;

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut input = MidiInput::new("monitor")?;
    input.ignore(Ignore::None); // receive SysEx, clock and active sensing too
    let ports = input.ports();
    let port = ports.first().ok_or("no input ports")?;
    println!("Listening on {}", input.port_name(port)?);

    let _conn = input.connect(port, "monitor-in", |stamp, message, _| {
        let hex: Vec<String> = message.iter().map(|b| format!("{b:02X}")).collect();
        println!("{stamp:>12} µs  {}", hex.join(" "));
    }, ())?;

    stdin().read_line(&mut String::new())?; // keep the connection open
    Ok(())
}`,
