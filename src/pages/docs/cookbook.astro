        code: String.raw`import mido

mid = mido.MidiFile('song.mid')
t = 0.0
for msg in mid:            # tracks merged; msg.time is the delta in seconds (tempo-aware)
    t += msg.time
    if msg.type == 'note_on' and msg.velocity > 0:
        print(f'{t:8.3f}s  ch{msg.channel + 1}  note {msg.note}  vel {msg.velocity}')`,
