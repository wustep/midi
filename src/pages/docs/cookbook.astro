      {
        lang: 'cpp', lib: 'RtMidi', libQuery: 'rtmidi',
        code: String.raw`#include <chrono>
#include <cstdio>
#include <thread>
#include <vector>
#include "RtMidi.h"

int main() {
  RtMidiIn in;
  RtMidiOut out;
  if (in.getPortCount() == 0 || out.getPortCount() == 0) return 1;
  in.openPort(0);
  out.openPort(0);
  in.ignoreTypes(false, true, true);  // SysEx is ignored by default

  std::vector<unsigned char> req{0xF0, 0x7E, 0x7F, 0x06, 0x01, 0xF7}, msg;
  out.sendMessage(&req);
  for (int i = 0; i < 200; i++) {  // poll for up to ~2 s
    in.getMessage(&msg);
    if (msg.size() > 5 && msg[0] == 0xF0 && msg[1] == 0x7E && msg[3] == 0x06 && msg[4] == 0x02) {
      for (unsigned char b : msg) std::printf("%02X ", b);
      std::printf("\n");
      return 0;
    }
    std::this_thread::sleep_for(std::chrono::milliseconds(10));
  }
  return 2;  // no reply
}`,
