        lang: 'rs', lib: 'midly', libQuery: 'midly',
        code: String.raw`use midly::num::{u15, u24, u28, u4, u7};
use midly::{Format, Header, MetaMessage, MidiMessage, Smf, Timing, TrackEvent, TrackEventKind};

fn main() -> std::io::Result<()> {
