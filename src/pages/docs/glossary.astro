---
import Doc from '../../layouts/Doc.astro';
import { terms, termSlug as slug } from '../../lib/glossary';

const letterOf = (s: string) => (/^[0-9]/.test(s) ? '#' : s[0].toUpperCase());
const sorted = [...terms].sort((a, b) => a[0].localeCompare(b[0], 'en', { sensitivity: 'base' }));
const letters = [...new Set(sorted.map(([t]) => letterOf(t)))];
const letterId = (l: string) => (l === '#' ? 'letter-0-9' : `letter-${l.toLowerCase()}`);
---

<Doc title="Glossary" slug="glossary" specs={[{ label: 'MIDI Association specifications', href: 'https://midi.org/specs' }]}>
  <p class="lede">
    Short, plain-language definitions of the words you'll meet in MIDI specs, manuals, and forum threads. Each entry
    links to the page that covers it in depth.
  </p>

  <nav class="az jump-nav" aria-label="Jump to letter">
    {letters.map((l) => <a href={`#${letterId(l)}`}>{l === '#' ? '0–9' : l}</a>)}
  </nav>

  <div class="gl-filter" hidden>
    <label class="field-label" for="gl-q">Filter terms</label>
    <input id="gl-q" type="search" placeholder="e.g. clock, SysEx, zone" autocomplete="off" />
    <p class="gl-count" aria-live="polite"></p>
  </div>

  {
    letters.map((l) => (
      <section class="gl-letter" aria-labelledby={letterId(l)}>
        <h2 id={letterId(l)}>{l === '#' ? '0–9' : l}</h2>
        <dl class="gl">
          {sorted
            .filter(([t]) => letterOf(t) === l)
            .map(([t, d]) => (
              <div class="gl-item" data-text={`${t} ${d.replace(/<[^>]+>/g, '')}`.toLowerCase()}>
                <dt id={slug(t)}>
                  <a class="gl-anchor" href={`#${slug(t)}`}>{t}</a>
                </dt>
                <dd set:html={d} />
              </div>
            ))}
        </dl>
      </section>
    ))
  }
</Doc>

<script>
  const wrap = document.querySelector<HTMLElement>('.gl-filter');
  const input = document.querySelector<HTMLInputElement>('#gl-q');
  const count = document.querySelector<HTMLElement>('.gl-count');
  if (wrap && input && count) {
    wrap.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('.gl-item')];
    const sections = [...document.querySelectorAll<HTMLElement>('.gl-letter')];
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      let shown = 0;
      for (const it of items) {
        const ok = !q || it.dataset.text!.includes(q);
        it.hidden = !ok;
        if (ok) shown++;
      }
      for (const s of sections) s.hidden = !s.querySelector('.gl-item:not([hidden])');
      count.textContent = q ? `${shown} of ${items.length} terms` : '';
    });
  }
</script>

<style>
  .gl-filter {
    max-width: 28rem;
    margin-bottom: var(--s-4);
  }
  .gl-count {
    font-size: var(--t-md);
    color: var(--muted);
    min-height: 1.3em;
    margin: var(--s-1) 0 0;
  }
  .gl-letter[hidden],
  .gl-item[hidden] {
    display: none;
  }
  .gl {
    margin: 0;
  }
  .gl-item {
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .gl-item:last-child {
    border-bottom: 0;
  }
  .gl dt {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: var(--t-base);
    margin-bottom: var(--s-1);
  }
  .gl-anchor {
    color: var(--ink);
    text-decoration: none;
  }
  .gl-anchor:hover {
    color: var(--accent);
  }
  .gl dd {
    margin: 0;
    color: var(--ink-2);
    max-width: var(--measure);
  }
</style>
