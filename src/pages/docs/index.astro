---
import Base from '../../layouts/Base.astro';
import { docGroups, docsFlat } from '../../lib/docs-nav';
import { tools } from '../../lib/tools';

const path = ['intro', 'messages', 'notes', 'control-change'].map((s) => docsFlat.find((d) => d.slug === s)!);
const gid = (t: string) => `g-${t.replace(/\W+/g, '-').toLowerCase()}`;
---

<Base
  title="Docs"
  section="/docs"
  description="A practical reference to the MIDI protocol: messages, Standard MIDI Files, timing, SysEx, General MIDI, MPE, MIDI 2.0, MIDI-CI and transports."
>
  <div class="page">
    <header class="page-head">
      <p class="eyebrow">Docs</p>
      <h1>How MIDI actually works</h1>
      <p class="lede">
        A byte-level guide to the protocol: messages, files, clocks, expressive extensions and MIDI 2.0. Written for
        people building instruments, plugins, firmware and tools, and checked against the official specifications.
      </p>
    </header>

    <section class="start" aria-labelledby="start-title">
      <h2 id="start-title" class="start-title">New to MIDI? Read these in order</h2>
      <ol class="path">
        {
          path.map((d, i) => (
            <li>
              <a href={`/docs/${d.slug}/`}>
                <span class="n">{i + 1}</span>
                <span>
                  <strong>{d.title}</strong>
                  <small>{d.summary}</small>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      docGroups.map((g) => (
        <section class="group" aria-labelledby={gid(g.title)}>
          <h2 id={gid(g.title)} class="group-title">{g.title}</h2>
          <ul class="card-grid">
            {g.items.map((d) => (
              <li>
                <a class="card" href={`/docs/${d.slug}/`}>
                  <span class="card-title">{d.title}</span>
                  <span class="card-text">{d.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="related docs-related">
      <div><strong>Hands-on</strong><a href="/reader/">MIDI Reader</a><a href="/tools/monitor/">Web MIDI monitor</a><a href="/tools/">All {tools.length} tools</a></div>
      <div><strong>Code</strong><a href="/libraries/">Library catalog</a><a href="/docs/cookbook/">Cookbook</a></div>
    </div>
  </div>
</Base>

<style>
  .start {
    margin-bottom: var(--s-6);
  }
  .start-title {
    font-size: var(--t-base);
    margin: 0 0 var(--s-3);
  }
  .path {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }
  .path a {
    display: flex;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .path a:hover {
    border-color: var(--accent);
  }
  .path .n {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--t-sm);
  }
  .path span:last-child {
    display: grid;
    gap: 0.15rem;
  }
  .path small {
    font-size: var(--t-xs);
    color: var(--ink-2);
    line-height: 1.4;
  }
  .group {
    padding: var(--s-5) 0 var(--s-2);
    border-top: 1px solid var(--line);
  }
  .group-title {
    font-size: var(--t-lg);
    margin: 0 0 var(--s-3);
  }
  .docs-related {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .path {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .path {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
