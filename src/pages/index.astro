---
import Base from '../layouts/Base.astro';
import HeroStream from '../components/HeroStream.astro';
import libraries from '../../data/libraries.json';
import categories from '../../data/categories.json';
import community from '../../data/community.json';
import midiFiles from '../../data/midi-files.json';
import instruments from '../../data/samples.json';
import { docsFlat } from '../lib/docs-nav';
import { tools, toolBySlug } from '../lib/tools';

const quickRef = [
  ['8n', 'Note Off', 'note, velocity'],
  ['9n', 'Note On', 'note, velocity'],
  ['An', 'Poly Pressure', 'note, pressure'],
  ['Bn', 'Control Change', 'controller, value'],
  ['Cn', 'Program Change', 'program'],
  ['Dn', 'Channel Pressure', 'pressure'],
  ['En', 'Pitch Bend', 'LSB, MSB'],
  ['F0', 'System Exclusive', '… F7'],
];

const libCount = libraries.length;
const libRounded = Math.floor(libCount / 10) * 10;
const languages = new Set(libraries.map((l) => l.language)).size;
const startHere = ['intro', 'messages', 'notes', 'control-change', 'smf', 'midi-2'].map((s) => docsFlat.find((d) => d.slug === s)!);
const featured = ['reader', 'monitor', 'cc'].map(toolBySlug);
const topCats = [...categories]
  .map((c) => ({ ...c, n: libraries.filter((l) => l.category === c.id).length, top: libraries.filter((l) => l.category === c.id && !l.archived).sort((a, b) => b.stars - a.stars).slice(0, 3) }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 6);
---

<Base title="MIDI Field Guide">
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">An open reference</p>
      <h1><span>The field</span> <span>guide</span> <span>to <span class="hl">MIDI</span>.</span></h1>
      <p class="lede">
        How MIDI works down to the byte, from MIDI 1.0 to MIDI 2.0. A MIDI file reader, playable instruments, a live
        Web MIDI monitor, runnable recipes, and {libRounded}+ open-source libraries, each one checked against its repository.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="/docs/">Read the docs</a>
        <a class="btn" href="/reader/">Open a MIDI file</a>
        <a class="btn" href="/libraries/">Browse {libRounded}+ libraries</a>
      </div>
      <p class="newbie">New to MIDI? Start with <a href="/docs/intro/">MIDI in five minutes →</a></p>
    </div>

    <HeroStream />
  </section>
  <div class="page home">
    <section class="band" aria-labelledby="start-title">
      <div class="band-head">
        <h2 id="start-title">Start here</h2>
        <p>Short chapters with tables you can scan and worked byte examples. <a href="/docs/">All {docsFlat.length} chapters →</a></p>
      </div>
      <div class="start-grid">
        <ul class="card-grid start-cards">
          {
            startHere.map((d) => (
              <li>
                <a class="card" href={`/docs/${d.slug}/`}>
                  <span class="card-title">{d.title}</span>
                  <span class="card-text">{d.summary}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="qr">
          <div class="table-wrap">
            <table>
              <caption>Status bytes at a glance</caption>
              <thead>
                <tr><th scope="col">Status</th><th scope="col">Message</th><th scope="col">Data</th></tr>
              </thead>
              <tbody>
                {
                  quickRef.map(([st, m, d]) => (
                    <tr>
                      <td><span class="b b-s">{st}</span></td>
                      <td>{m}</td>
                      <td class="dim">{d}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="qr-note"><code>n</code> = channel − 1 (0–F). Full tables in <a href="/docs/messages/">Messages</a>.</p>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="tools-title">
      <div class="band-head">
        <h2 id="tools-title">Tools</h2>
        <p>Everything runs in your browser; files are never uploaded. <a href="/tools/">All {tools.length} tools →</a></p>
      </div>
      <ul class="card-grid feature-cards">
        {
          featured.map((t) => (
            <li>
              <a class="card" href={t.href}>
                <span class="demo" aria-hidden="true">
                  <code>{t.demo[0]}</code>
                  <span class="arrow">→</span>
                  <code class="out">{t.demo[1]}</code>
                </span>
                <span class="card-title">{t.title}</span>
                <span class="card-text">{t.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band" aria-labelledby="libraries-title">
      <div class="band-head">
        <h2 id="libraries-title">Libraries</h2>
        <p>
          {libCount} open-source projects in {languages} languages, each checked against its repository on GitHub or Codeberg.
          <a href="/libraries/">Browse all {categories.length} categories →</a>
        </p>
      </div>
      <form class="lib-search" action="/libraries/" method="get" role="search">
        <label class="visually-hidden" for="home-q">Search libraries</label>
        <input id="home-q" name="q" type="search" placeholder="rust, soundfont, mpe, arduino…" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
      <ul class="card-grid cat-cards">
        {
          topCats.map((c) => (
            <li>
              <a class="card" href={`/libraries/?cat=${c.id}`}>
                <span class="card-kicker">{c.n} projects</span>
                <span class="card-title">{c.title}</span>
                <span class="card-meta">{c.top.map((l) => l.name).join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band more" aria-label="More">
      <ul class="card-grid more-cards">
        <li>
          <a class="card" href="/samples/">
            <span class="card-kicker">Samples</span>
            <span class="card-title">Play {instruments.length} free instruments</span>
            <span class="card-text">Openly licensed sounds you can play with a keyboard or MIDI controller, plus SoundFont and SFZ libraries.</span>
          </a>
        </li>
        <li>
          <a class="card" href="/community/">
            <span class="card-kicker">Community</span>
            <span class="card-title">{community.length} places to ask</span>
            <span class="card-text">Forums, subreddits, Discord servers and mailing lists, and {midiFiles.length} sources of MIDI files.</span>
          </a>
        </li>
        <li>
          <a class="card" href="/docs/cookbook/">
            <span class="card-kicker">Reference</span>
            <span class="card-title">Cookbook &amp; glossary</span>
            <span class="card-text">Runnable recipes in JavaScript, Python, C++ and Rust, plus plain-language definitions.</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6.5rem) var(--gutter) clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: center;
  }
  /* Three fixed lines that never wrap, so the headline is the same height in the fallback font and in
     Archivo: no layout shift when the web font arrives. */
  .hero h1 > span {
    display: block;
    white-space: nowrap;
  }
  .hero h1 {
    font-size: var(--t-display);
    line-height: 0.98;
    font-stretch: 125%;
    font-weight: var(--w-black);
    letter-spacing: -0.035em; /* a notch tighter than --tr-display at weight 900 */
    margin-bottom: var(--s-5);
  }
  .hl {
    color: var(--accent);
  }
  .newbie {
    margin: var(--s-4) 0 0;
    font-size: var(--t-md);
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .qr {
    position: sticky;
    top: 5rem;
  }
  .qr .table-wrap {
    margin-top: 0;
  }
  .qr caption {
    text-align: left;
    padding: var(--s-3) var(--s-3) var(--s-2);
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
  }
  .dim {
    color: var(--muted);
  }
  .qr-note {
    font-size: var(--t-md);
    color: var(--muted);
  }

  /* Libraries */
  .home {
    --page-top: 0;
  }
  .band {
    padding: var(--s-7) 0;
    border-top: 1px solid var(--line);
  }
  .band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin-bottom: var(--s-5);
  }
  .band-head h2 {
    font-size: var(--t-2xl);
    margin: 0;
  }
  .band-head p {
    margin: 0;
    color: var(--ink-2);
    max-width: 44rem;
  }
  .start-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: start;
  }
  .start-cards {
    --card-min: 230px;
  }
  .feature-cards {
    --card-min: 300px;
  }
  .feature-cards .card-title {
    font-size: var(--t-lg);
  }
  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-bottom: var(--s-2);
    font-size: var(--t-xs);
  }
  .demo code {
    background: var(--surface-sunken);
    border: 1px solid var(--line);
  }
  .demo .out {
    color: var(--data);
  }
  .arrow {
    color: var(--muted);
  }
  .lib-search {
    display: flex;
    gap: var(--s-2);
    max-width: 34rem;
    margin-bottom: var(--s-4);
  }
  .cat-cards,
  .more-cards {
    --card-min: 330px;
  }
  .more {
    border-top: 0;
    padding-top: 0;
    padding-bottom: 0;
  }
  /* Secondary destinations: flat on the page (no raise) so they sit below the main bands. */
  .more-cards .card {
    background: transparent;
    box-shadow: none;
  }
  @media (max-width: 900px) {
    .hero,
    .start-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .band {
      padding-top: var(--s-6);
    }
    .start-cards .card-text,
    .cat-cards .card-meta {
      display: none;
    }
    .start-cards,
    .cat-cards {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-2);
    }
    .start-cards .card,
    .cat-cards .card {
      padding: var(--s-3);
    }
  }
</style>
