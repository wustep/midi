---
import Base from '../layouts/Base.astro';
import libraries from '../../data/libraries.json';
import categories from '../../data/categories.json';
import { docsForCategory, toolsForCategory } from '../lib/related';
import { repoUrl, repoLabel } from '../lib/repo.mjs';
import picks from '../../data/picks.json';

type Lib = (typeof libraries)[number];

const byStars = (a: Lib, b: Lib) => Number(a.archived) - Number(b.archived) || (b.stars ?? 0) - (a.stars ?? 0);
const sorted = [...libraries].sort(byStars);

// Top languages by count for the filter (rest grouped under "Other").
const langCounts = new Map<string, number>();
for (const l of libraries) langCounts.set(l.language, (langCounts.get(l.language) ?? 0) + 1);
const languages = [...langCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const catTitle = Object.fromEntries(categories.map((c) => [c.id, c.short]));
const fmtStars = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));
const verifiedAt = libraries.map((l) => l.verifiedAt).sort().at(-1);
const pickRepos = new Set(picks.flatMap((g) => g.picks.map((p) => p.repo.toLowerCase())));
const libByRepo = new Map(libraries.map((l) => [l.repo.toLowerCase(), l]));
const year = (d: string | null) => (d ? d.slice(0, 4) : '');
// "Stale" relative to the last verification, so the label doesn't drift as the data ages.
const stale = (d: string | null) => Boolean(d && verifiedAt && Number(verifiedAt.slice(0, 4)) - Number(d.slice(0, 4)) >= 2);
const context = Object.fromEntries(
  categories.map((c) => [c.id, { blurb: c.blurb, docs: docsForCategory(c.id), tools: toolsForCategory(c.id).map((t) => ({ label: t.title, href: t.href })) }]),
);
---

<Base title="Libraries" section="/libraries" description={`${libraries.length} open-source MIDI libraries and tools, verified against GitHub: parsing, realtime I/O, Web MIDI, synthesis, firmware, DAWs, notation, ML and MIDI 2.0.`}>
  <div class="page lib-page">
    <header class="page-head lib-header">
      <p class="eyebrow">Libraries</p>
      <h1>Open-source MIDI libraries</h1>
      <p class="lede">
        {libraries.length} projects across {categories.length} categories. Every entry is checked against the GitHub API
        for existence, stars, license, and activity{verifiedAt && <> (last checked <time datetime={verifiedAt}>{verifiedAt}</time>)</>}.
        Also available as a plain <a href="https://github.com/wustep/midi#readme">awesome list on GitHub</a>.
      </p>
    </header>

    <details class="starters" open data-fold-phone>
      <summary><h2>Where to start</h2><span>Dependable first choices by language. Everything else is below.</span></summary>
      <div class="starter-grid">
        {
          picks.map((g) => (
            <section>
              <h3>{g.language}</h3>
              <ul>
                {g.picks.map((p) => {
                  const lib = libByRepo.get(p.repo.toLowerCase())!;
                  return (
                    <li>
                      <a href={repoUrl(lib)}>{lib.name}</a> <span class="task">{p.task}</span>
                      <p>{p.why}</p>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </details>

    <form class="filters" role="search" aria-label="Filter libraries" onsubmit="return false">
      <div class="f-search">
        <label class="field-label" for="q">Search</label>
        <input id="q" type="search" placeholder="name, description, owner…" autocomplete="off" />
      </div>
      <div>
        <label class="field-label" for="f-lang">Language</label>
        <select id="f-lang">
          <option value="">All languages</option>
          {languages.map(([l, n]) => <option value={l}>{l} ({n})</option>)}
        </select>
      </div>
      <div>
        <label class="field-label" for="f-sort">Sort</label>
        <select id="f-sort">
          <option value="stars">Most stars</option>
          <option value="recent">Recently updated</option>
          <option value="name">Name A–Z</option>
        </select>
      </div>
      <label class="f-check">
        <input id="f-archived" type="checkbox" checked />
        Show archived
      </label>
    </form>

    <div class="cats" role="group" aria-label="Category">
      <button type="button" class="cat" data-cat="" aria-pressed="true">All <span>{libraries.length}</span></button>
      {
        categories.map((c) => (
          <button type="button" class="cat" data-cat={c.id} aria-pressed="false" title={c.blurb}>
            {c.short} <span>{libraries.filter((l) => l.category === c.id).length}</span>
          </button>
        ))
      }
    </div>

    <div class="cat-context" id="cat-context" hidden></div>
    <p class="count" aria-live="polite"><span id="count">{libraries.length}</span> <span id="count-label">projects</span></p>

    <ul class="grid" id="grid">
      {
        sorted.map((l) => (
          <li
            class="card"
            data-cat={l.category}
            data-lang={l.language}
            data-stars={l.stars}
            data-pushed={l.pushedAt}
            data-name={l.name.toLowerCase()}
            data-archived={String(l.archived)}
            data-search={`${l.name} ${repoLabel(l)} ${l.description} ${l.language} ${catTitle[l.category]}`.toLowerCase()}
          >
            <div class="card-top">
              <h2 class="card-title">
                <a href={repoUrl(l)}>{l.name}</a>
              </h2>
              <span class="stars" title={`${l.stars} stars`}>
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path fill="currentColor" d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.3l-4.5 2.3.9-5L.8 6.1l5-.7z" />
                </svg>
                <span class="visually-hidden">Stars: </span>
                {fmtStars(l.stars ?? 0)}
              </span>
            </div>
            <p class="repo">{repoLabel(l)}</p>
            <p class="desc">{l.description}</p>
            <div class="meta">
              {pickRepos.has(l.repo.toLowerCase()) && <span class="tag tag-pick">Starter pick</span>}
              <span class="tag tag-cat">{catTitle[l.category]}</span>
              <span class="tag">{l.language}</span>
              {l.license && <span class="tag tag-quiet">{l.license}</span>}
              {l.archived ? (
                <span class="tag tag-warn">Archived</span>
              ) : (
                l.pushedAt && <span class:list={['tag', stale(l.pushedAt) ? 'tag-stale' : 'tag-quiet']} title={`Last push ${l.pushedAt}`}>Updated {year(l.pushedAt)}</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more-wrap"><button type="button" class="btn" id="more" hidden>Show more</button></p>
    <p class="empty" id="empty" hidden>No libraries match. Try clearing a filter, or <a href="https://github.com/wustep/midi/blob/main/CONTRIBUTING.md">suggest one</a>.</p>
  </div>
</Base>

<script define:vars={{ context }} is:inline>
  window.__libContext = context;
</script>

<script>
  const PAGE = 48;
  let limit = PAGE;
  const more = document.querySelector<HTMLButtonElement>('#more')!;
  const ctxEl = document.querySelector<HTMLElement>('#cat-context')!;
  const contextData = (window as unknown as { __libContext: Record<string, { blurb: string; docs: { label: string; href: string }[]; tools: { label: string; href: string }[] }> }).__libContext;
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const lang = document.querySelector<HTMLSelectElement>('#f-lang')!;
  const sort = document.querySelector<HTMLSelectElement>('#f-sort')!;
  const archived = document.querySelector<HTMLInputElement>('#f-archived')!;
  const grid = document.querySelector<HTMLUListElement>('#grid')!;
  const count = document.querySelector<HTMLElement>('#count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const catBtns = [...document.querySelectorAll<HTMLButtonElement>('.cat')];
  const cards = [...grid.querySelectorAll<HTMLLIElement>('.card')];
  let cat = '';

  // Restore state from the URL so filtered views are shareable.
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  lang.value = params.get('lang') ?? '';
  sort.value = params.get('sort') ?? 'stars';
  cat = params.get('cat') ?? '';
  archived.checked = params.get('archived') !== '0';

  function apply(resetLimit = true) {
    if (resetLimit) limit = PAGE;
    const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const key = sort.value;
    const sorted = [...cards].sort((a, b) => {
      if (key === 'name') return a.dataset.name!.localeCompare(b.dataset.name!);
      if (key === 'recent') return (b.dataset.pushed ?? '').localeCompare(a.dataset.pushed ?? '');
      return (
        Number(a.dataset.archived === 'true') - Number(b.dataset.archived === 'true') ||
        Number(b.dataset.stars) - Number(a.dataset.stars)
      );
    });
    grid.append(...sorted);
    // Filter in display order and show only the first `limit` matches.
    let shown = 0;
    for (const c of sorted) {
      const ok =
        (!cat || c.dataset.cat === cat) &&
        (!lang.value || c.dataset.lang === lang.value) &&
        (archived.checked || c.dataset.archived !== 'true') &&
        terms.every((t) => c.dataset.search!.includes(t));
      c.hidden = !ok || shown >= limit;
      if (ok) shown++;
    }
    count.textContent = shown > limit ? `${limit} of ${shown}` : String(shown);
    document.querySelector('#count-label')!.textContent = shown === 1 ? 'project' : 'projects';
    more.hidden = shown <= limit;
    more.textContent = `Show ${Math.min(PAGE, shown - limit)} more`;
    empty.hidden = shown > 0;
    const c = cat && contextData[cat];
    ctxEl.hidden = !c;
    if (c) {
      const links = [...c.docs.map((d) => `<a href="${d.href}">${d.label}</a>`)];
      const toolLinks = c.tools.map((t) => `<a href="${t.href}">${t.label}</a>`);
      ctxEl.innerHTML = `<p>${c.blurb}</p><div class="related">${links.length ? `<div><strong>Read first</strong>${links.join('')}</div>` : ''}${toolLinks.length ? `<div><strong>Try it</strong>${toolLinks.join('')}</div>` : ''}</div>`;
    }
    for (const b of catBtns) b.setAttribute('aria-pressed', String(b.dataset.cat === cat));

    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    if (cat) p.set('cat', cat);
    if (lang.value) p.set('lang', lang.value);
    if (sort.value !== 'stars') p.set('sort', sort.value);
    if (!archived.checked) p.set('archived', '0');
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  q.addEventListener('input', () => apply());
  lang.addEventListener('change', () => apply());
  sort.addEventListener('change', () => apply());
  archived.addEventListener('change', () => apply());
  more.addEventListener('click', () => {
    limit += PAGE;
    apply(false);
  });
  for (const b of catBtns)
    b.addEventListener('click', () => {
      cat = b.dataset.cat ?? '';
      apply();
    });
  apply();
</script>

<style>
  .lib-page {
    --page-top: var(--s-6);
  }
  .cat-context {
    margin: var(--s-3) 0 0;
    padding: var(--s-3) var(--s-4);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: var(--radius-sm);
  }
  .cat-context :global(p) {
    margin: 0;
    font-size: var(--t-sm);
  }
  .cat-context :global(.related) {
    margin-top: var(--s-2);
  }
  .more-wrap {
    text-align: center;
    margin: var(--s-5) 0 0;
  }
  .tag-pick {
    background: var(--data-soft);
    color: var(--data);
    font-weight: 700;
  }
  .starters {
    margin: 0 0 var(--s-6);
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .starters > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
    cursor: pointer;
    list-style: none;
    min-height: 2.5rem;
  }
  .starters > summary::-webkit-details-marker {
    display: none;
  }
  .starters > summary h2 {
    font-size: var(--t-lg);
    margin: 0;
  }
  .starters > summary span {
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .starter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-3);
  }
  .starter-grid h3 {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--s-2);
  }
  .starter-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-2);
  }
  .starter-grid li a {
    font-weight: 700;
  }
  .starter-grid .task {
    font-size: var(--t-xs);
    color: var(--muted);
  }
  .starter-grid p {
    margin: 0.1rem 0 0;
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1.45;
  }
  .tag-stale {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .lib-header {
    margin-bottom: 2rem;
  }
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }
  .f-check {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .f-check input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .cat {
    border: 1px solid var(--control);
    background: var(--surface);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 2.25rem;
  }
  @media (pointer: coarse) {
    .cat {
      min-height: 2.75rem;
    }
  }
  .cat span {
    color: var(--muted);
    font-weight: 400;
    margin-left: 0.15rem;
  }
  .cat:hover {
    border-color: var(--ink-2);
  }
  .cat[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .cat[aria-pressed='true'] span {
    color: inherit;
    opacity: 0.7;
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 0.9rem;
    position: relative;
    transition: border-color 0.15s ease;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--line-strong);
  }
  .card[hidden] {
    display: none;
  }
  .card[data-archived='true'] {
    background: var(--bg);
    border-style: dashed;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }
  .card-title {
    font-size: 1.08rem;
    margin: 0;
    font-stretch: 108%;
  }
  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .card-title a:hover {
    color: var(--accent);
  }
  .card-title a:focus-visible {
    outline: none;
  }
  .card-title a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .repo {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0.1rem 0 0.5rem;
    overflow-wrap: anywhere;
  }
  .desc {
    font-size: 0.94rem;
    color: var(--ink-2);
    line-height: 1.5;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag {
    font-size: 0.74rem;
    font-weight: 600;
    border-radius: 4px;
    padding: 0.1rem 0.45rem;
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .tag-cat {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .tag-quiet {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
    font-weight: 400;
  }
  .tag-warn {
    background: var(--warn-soft);
    color: var(--warn);
  }
  .empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }
    .f-search {
      grid-column: 1 / -1;
    }
  }
</style>
