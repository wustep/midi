---
/**
 * Open Graph card templates (1200×630), one per site section. Not linked or indexed: they're rendered
 * once and screenshotted to public/og/<section>.png (see CONTRIBUTING.md).
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../../styles/global.css';
import libraries from '../../../data/libraries.json';
import { tools } from '../../lib/tools';
import { docsFlat } from '../../lib/docs-nav';
import community from '../../../data/community.json';

export function getStaticPaths() {
  return ['home', 'docs', 'tools', 'reader', 'libraries', 'samples', 'community'].map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const n = Math.floor(libraries.length / 10) * 10;
const langs = new Set(libraries.map((l) => l.language)).size;
const cards: Record<string, { kicker: string; title: string; sub: string; bytes: [string, string][] }> = {
  home: { kicker: 'midi.community', title: 'The field guide to MIDI.', sub: `Docs, ${tools.length} browser tools and ${n}+ verified open-source libraries.`, bytes: [['90', 's'], ['3C', 'd'], ['64', 'd']] },
  docs: { kicker: 'Docs', title: 'How MIDI actually works', sub: `${docsFlat.length} byte-level chapters, from MIDI 1.0 to MIDI 2.0.`, bytes: [['B0', 's'], ['40', 'd'], ['7F', 'd']] },
  tools: { kicker: 'Tools', title: 'MIDI tools in your browser', sub: 'Inspect files and streams, build SysEx and RPNs, look up CCs and chords.', bytes: [['F0', 's'], ['41', 'm'], ['F7', 's']] },
  reader: { kicker: 'MIDI Reader', title: 'What’s inside your .mid file?', sub: 'Tracks, tempo, controllers, SysEx, a piano roll, and every byte.', bytes: [['4D', 'm'], ['54', 'm'], ['68', 'm'], ['64', 'm']] },
  libraries: { kicker: 'Libraries', title: `${n}+ open-source MIDI libraries`, sub: `${langs} languages, each checked against the GitHub API.`, bytes: [['C0', 's'], ['00', 'd']] },
  samples: { kicker: 'Samples', title: 'Play free instruments', sub: 'Openly licensed sounds in the browser, plus SoundFont and SFZ libraries.', bytes: [['99', 's'], ['24', 'd'], ['7F', 'd']] },
  community: { kicker: 'Community', title: 'Where MIDI people talk', sub: `${community.length} forums, subreddits, Discords and lists, plus where to get MIDI files.`, bytes: [['F8', 's'], ['F8', 's'], ['F8', 's']] },
};
const c = cards[section!];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG {section}</title>
  </head>
  <body>
    <div class="og">
      <div class="brand">
        <svg class="din" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <rect x="13.5" y="1" width="5" height="4" rx="1" fill="currentColor"></rect>
          <circle cx="7.5" cy="15" r="2" fill="currentColor"></circle>
          <circle cx="24.5" cy="15" r="2" fill="currentColor"></circle>
          <circle cx="10" cy="21.5" r="2" fill="currentColor"></circle>
          <circle cx="22" cy="21.5" r="2" fill="currentColor"></circle>
          <circle cx="16" cy="24" r="2" fill="#a83508"></circle>
        </svg>
        <span>MIDI <small>Field Guide</small></span>
      </div>
      <p class="kicker">{c.kicker}</p>
      <h1>{c.title}</h1>
      <p class="sub">{c.sub}</p>
      <div class="bytes">
        {c.bytes.map(([b, k]) => <span class={`byte ${k}`}>{b}</span>)}
      </div>
      {
        section === 'samples' && (
          <div class="keys">
            {Array.from({ length: 15 }, (_, i) => <span class:list={[{ on: i === 2 || i === 4 || i === 7 }]} />)}
          </div>
        )
      }
      <p class="url">midi.community{section === 'home' ? '' : `/${section}`}</p>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #f2efe6;
  }
</style>
<style>
  .og {
    position: relative;
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 64px 72px;
    background: radial-gradient(circle at 92% 8%, rgb(168 53 8 / 0.08), transparent 40%), #f2efe6;
    color: #1a1915;
    font-family: var(--font-text);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: 30px;
  }
  .brand small {
    font-weight: 500;
    font-stretch: 100%;
    font-size: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #645e52;
    margin-left: 6px;
  }
  .din {
    width: 44px;
    height: 44px;
  }
  .kicker {
    margin: 64px 0 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 120%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 22px;
    color: #a83508;
  }
  h1 {
    margin: 0;
    max-width: 700px;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 125%;
    font-size: 76px;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .sub {
    margin: 24px 0 0;
    max-width: 640px;
    font-size: 28px;
    line-height: 1.35;
    color: #3d3a33;
  }
  .bytes {
    position: absolute;
    right: 72px;
    top: 200px;
    display: grid;
    gap: 14px;
  }
  .byte {
    display: grid;
    place-items: center;
    width: 220px;
    height: 76px;
    border-radius: 16px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 48px;
  }
  .s {
    background: #f6dccd;
    color: #a83508;
  }
  .d {
    background: #d2ebe7;
    color: #0b6b63;
  }
  .m {
    background: #e6ddf6;
    color: #6b4bb0;
  }
  .keys {
    position: absolute;
    right: 72px;
    bottom: 56px;
    display: grid;
    grid-template-columns: repeat(15, 13px);
    gap: 2px;
    height: 54px;
  }
  .keys span {
    background: #fbfaf6;
    border: 1px solid #b9b09c;
    border-radius: 0 0 3px 3px;
  }
  .keys .on {
    background: #f6dccd;
    box-shadow: inset 0 -4px 0 #a83508;
  }
  .url {
    position: absolute;
    left: 72px;
    bottom: 52px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 22px;
    color: #645e52;
  }
</style>
