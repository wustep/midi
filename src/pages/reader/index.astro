---
import Base from '../../layouts/Base.astro';
import MidiReader from '../../components/MidiReader.astro';
import Shortcuts from '../../components/Shortcuts.astro';
---

<Base
  title="MIDI Reader"
  section="/reader"
  description="Open a Standard MIDI File in your browser and see every part explained: header, tracks, programs, tempo map, meta events, controllers, SysEx, a piano roll, and an annotated hex view. Play it with sampled instruments. Nothing is uploaded."
>
  <div class="page reader-page">
    <header class="page-head reader-header">
      <p class="eyebrow">Reader</p>
      <h1>What's inside your .mid file?</h1>
      <p class="lede">
        Drop in a Standard MIDI File and read it like a book: the header, every track and instrument, tempo and key
        changes, controllers, SysEx, and each event down to the byte. Play it back with sampled instruments or your own
        MIDI gear. Everything happens in your browser.
      </p>
    </header>
    <MidiReader />
    <div class="reader-keys">
      <Shortcuts items={[['Space', 'Play or pause'], ['← / →', 'Back or forward 5 seconds'], ['Home', 'Back to the start'], ['Click a byte', 'Find its event']]} />
    </div>
    <aside class="reader-foot" aria-label="Related">
      <p>
        New to the format? Read <a href="/docs/smf/">Standard MIDI Files</a> and
        <a href="/docs/general-midi/">General MIDI</a>. Looking for files? See
        <a href="/community/midi-files/">Getting MIDI files</a> for public-domain archives and datasets, with license notes.
        The bundled demos were written for this site and are CC0.
      </p>
    </aside>
  </div>
</Base>

<style>
  .reader-page {
    --page-top: var(--s-6);
  }
  .reader-keys {
    margin-top: 2.5rem;
  }
  .reader-foot {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 80ch;
  }
</style>
