---
import Base from '../layouts/Base.astro';
import MessageDecoder from '../components/MessageDecoder.astro';
import VlqTool from '../components/VlqTool.astro';
import NoteTable from '../components/NoteTable.astro';
import TempoCalc from '../components/TempoCalc.astro';

const tools = [
  { id: 'decoder', title: 'Message decoder', blurb: 'Paste raw bytes and see each message decoded, with running status handled.', doc: '/docs/messages/' },
  { id: 'vlq', title: 'VLQ encoder', blurb: 'Convert delta-times and lengths to and from Standard MIDI File variable-length quantities.', doc: '/docs/smf/' },
  { id: 'tempo', title: 'Tempo calculator', blurb: 'BPM, microseconds per quarter note, ticks, and MIDI clock intervals.', doc: '/docs/timing/' },
  { id: 'notes', title: 'Note table', blurb: 'All 128 note numbers with names, frequencies, and GM drum sounds. Click to hear.', doc: '/docs/notes/' },
];
---

<Base title="Tools" section="/tools" description="Interactive MIDI tools: message byte decoder, VLQ encoder, tempo calculator, and note-number/frequency table.">
  <div class="tools-page">
    <header>
      <p class="eyebrow">Workbench</p>
      <h1>Tools</h1>
      <p class="lede">Small, fast utilities for the everyday questions of MIDI work. They run entirely in your browser.</p>
      <nav class="toc" aria-label="Tools on this page">
        {
          tools.map((t) => (
            <a href={`#${t.id}`}>
              <strong>{t.title}</strong>
              <span>{t.blurb}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <section id="decoder" class="tool">
      <MessageDecoder initial="B0 65 00 B0 64 00 B0 06 0C B0 26 00" />
      <p class="more">Background: <a href="/docs/messages/">Messages</a> · <a href="/docs/rpn-nrpn/">RPN &amp; NRPN</a> · <a href="/docs/sysex/">SysEx</a></p>
    </section>
    <section id="vlq" class="tool">
      <VlqTool />
      <p class="more">Background: <a href="/docs/smf/#vlq">Standard MIDI Files</a></p>
    </section>
    <section id="tempo" class="tool">
      <TempoCalc />
      <p class="more">Background: <a href="/docs/timing/">Timing &amp; Sync</a></p>
    </section>
    <section id="notes" class="tool">
      <NoteTable />
      <p class="more">Background: <a href="/docs/notes/">Notes &amp; Pitch</a> · <a href="/docs/general-midi/">General MIDI</a></p>
    </section>
  </div>
</Base>

<style>
  .tools-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem var(--gutter) 0;
  }
  .toc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    margin: 2rem 0 1rem;
  }
  .toc a {
    display: grid;
    gap: 0.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.8rem 0.95rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
  }
  .toc a:hover {
    border-color: var(--accent);
  }
  .toc span {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .tool {
    margin-top: 2.5rem;
  }
  .more {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: -1rem;
  }
</style>
