---
import Base from '../../layouts/Base.astro';
import { tools, TOOL_GROUPS } from '../../lib/tools';

const blurbs: Record<string, string> = {
  Inspect: 'Look inside files and live streams.',
  'Build & send': 'Assemble messages and send them to devices.',
  'Look up': 'References you can play with.',
  Calculate: 'Quick conversions for timing and file encoding.',
};
const slug = (g: string) => g.toLowerCase().replace(/[^a-z]+/g, '-');
const legacy = Object.fromEntries(tools.filter((t) => t.href.startsWith('/tools/')).map((t) => [t.slug, t.href]));
---

<Base title="Tools" section="/tools" description="Interactive MIDI tools that run in your browser: MIDI Reader, Web MIDI monitor, message decoder, clock and latency tester, SysEx and RPN builders, MPE playground, CC map, chords and scales, note table, tempo and VLQ calculators.">
  <div class="page">
    <header class="page-head">
      <p class="eyebrow">Tools</p>
      <h1>MIDI tools in your browser</h1>
      <p class="lede">{tools.length} tools for the everyday questions of MIDI work. Nothing is installed, and files you open are never uploaded.</p>
    </header>

    {
      TOOL_GROUPS.map((g) => {
        const items = tools.filter((t) => t.group === g);
        const big = g === 'Inspect';
        return (
          <section class="group" aria-labelledby={`g-${slug(g)}`}>
            <div class="group-head">
              <h2 id={`g-${slug(g)}`}>{g}</h2>
              <p>{blurbs[g]}</p>
            </div>
            <ul class:list={['card-grid', { big }]}>
              {items.map((t) => (
                <li>
                  <a class="card" href={t.href}>
                    {big && (
                      <span class="demo" aria-hidden="true">
                        <code>{t.demo[0]}</code>
                        <span class="arrow">→</span>
                        <code class="out">{t.demo[1]}</code>
                      </span>
                    )}
                    <span class="card-title">{t.title}</span>
                    <span class="card-text">{t.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>

<script is:inline define:vars={{ legacy }}>
  // The tools used to live on this page as #anchors; send old links to their new pages.
  const target = legacy[location.hash.slice(1)];
  if (target) location.replace(target);
</script>

<style>
  .group {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--s-4) var(--s-6);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--line);
  }
  .group-head h2 {
    font-size: var(--t-lg);
    margin: 0 0 var(--s-1);
  }
  .group-head p {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .card-grid {
    --card-min: 230px;
  }
  .card-grid.big {
    --card-min: 380px;
  }
  .big .card-title {
    font-size: var(--t-lg);
  }
  .demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    margin-bottom: var(--s-2);
    font-size: var(--t-xs);
  }
  .demo code {
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .demo .out {
    color: var(--data);
  }
  .arrow {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
